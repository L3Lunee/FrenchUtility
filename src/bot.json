    "def _categories_aide(settings):",
    "    piece = settings.get(\"message_reward\", 1)",
    "    voc = settings.get(\"vocal_reward\", 1)",
    "    xpm = settings.get(\"exp_per_message\", 5)",
    "    xpv = settings.get(\"exp_per_minute_vocal\", 5)",
    "    return [",
    "        (\"demarrage\", \"🚀\", \"Démarrage\", \"L'essentiel pour commencer\", False, [",
    "            (\"Tes premières commandes\", [",
    "                \"`/profil` — ton profil complet (niveau, fortune, badges)\",",
    "                \"`/daily` — ta récompense quotidienne, avec bonus de série\",",
    "                \"`/travailler` — un métier qui paie mieux à chaque niveau\",",
    "                \"`/cooldowns` — tous tes temps d'attente d'un coup d'œil\",",
    "            ]),",
    "            (\"Comment gagner de l'argent et de l'XP\", [",
    "                f\"💬 **{piece}** {ui.DEVISE} et **{xpm}** XP par message (max 1 par minute)\",",
    "                f\"🔊 **{voc}** {ui.DEVISE} et **{xpv}** XP par minute de vocal actif\",",
    "                \"⚠️ Le vocal ne compte que si tu n'es **pas** en sourdine, **pas** AFK et **pas seul**\",",
    "            ]),",
    "            (\"💡 Astuce\", [\"Les montants acceptent `2k`, `1.5m`, `tout`, `moitié`, `25%` : `/deposer tout`, `/casino slots moitié`…\"]),",
    "        ]),",
    "        (\"economie\", \"💰\", \"Économie\", \"Argent, banque, métiers, box et boutique\", False, [",
    "            (\"Argent\", [",
    "                \"`/solde` · `/profil` — ta fortune, ton rang, ta place\",",
    "                \"`/deposer` · `/retirer` — la banque rapporte des intérêts chaque jour\",",
    "                \"`/pay` — donner de l'argent · `/classement` — les tops du serveur\",",
    "            ]),",
    "            (\"Gagner\", [",
    "                \"`/daily` (jusqu'à ×3 avec la série) · `/weekly`\",",
    "                \"`/travailler` · `/metiers` — 7 métiers débloqués par niveau\",",
    "                \"`/crime` — gros gain… ou grosse amende · `/peche` — des prises à revendre\",",
    "                \"`/mission liste` · `/mission reclamer`\",",
    "            ]),",
    "            (\"Dépenser & collectionner\", [",
