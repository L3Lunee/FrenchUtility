{
  "module": "bot",
  "language": "python",
  "description": "Point d'entree : evenements Discord, /help, taches planifiees, suivi vocal.",
  "entrypoint": true,
  "source": [
    "# bot.py - Point d'entrée principal du bot FrenchUtility",
    "import os",
    "import asyncio",
    "import itertools",
    "import logging",
    "from datetime import datetime",
    "",
    "import discord",
    "from discord import app_commands",
    "from discord.ext import commands, tasks",
    "from dotenv import load_dotenv",
    "",
    "import core          # stockage, configuration, économie de base",
    "import ui            # couleurs, embeds, formatage",
    "import economy       # portefeuille, box, missions, giveaways, classements",
    "import games         # jeux entre joueurs + casino",
    "import admin         # enchères, argent, rôles, antiraid, sauvegarde, captcha",
    "import moderation    # sanctions manuelles + automod + journal",
    "import community     # boutique de rôles, métiers, vocal temporaire, tickets…",
    "",
    "load_dotenv()",
    "",
    "# Journalisation dans data/bot.log (en plus de la console normale), utile",
    "# pour relire l'historique des logs même après un redémarrage.",
    "os.makedirs(\"data\", exist_ok=True)",
    "logging.basicConfig(",
    "    level=logging.INFO,",
    "    format=\"%(asctime)s | %(message)s\",",
    "    datefmt=\"%H:%M:%S\",",
    "    handlers=[",
    "        logging.FileHandler(os.path.join(\"data\", \"bot.log\"), encoding=\"utf-8\"),",
    "        logging.StreamHandler(),",
    "    ],",
    ")",
    "logger = logging.getLogger(\"frenchutility\")",
    "",
    "TOKEN = os.getenv(\"TOKEN\")",
    "PREFIX = os.getenv(\"PREFIX\", \"/\")",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Modules activables : chaque commande appartient à un module (voir",
    "# core.MODULE_DES_COMMANDES), que le serveur peut couper depuis le tableau de",
    "# bord ou /configurer module.",
    "# ---------------------------------------------------------------------------",
    "",
    "class Arbre(app_commands.CommandTree):",
    "    \"\"\"Arbre de commandes avec un contrôle commun à toutes les commandes.\"\"\"",
    "",
    "    async def interaction_check(self, interaction: discord.Interaction) -> bool:",
    "        commande = interaction.command",
    "        if commande is None or interaction.guild_id is None:",
    "            return True",
    "        racine = commande.root_parent.name if commande.root_parent else commande.name",
    "        module = core.module_de_commande(racine)",
    "        if module and not core.module_actif(interaction.guild_id, module):",
    "            if interaction.type == discord.InteractionType.autocomplete:",
    "                return False  # pas de message d'erreur sur une autocomplétion",
    "            emoji, nom, _d = core.MODULES[module]",
    "            texte = f\"Le module {emoji} **{nom}** est désactivé sur ce serveur.\"",
    "            if core.is_admin(interaction.user):",
    "                texte += \"\\nRéactive-le avec `/configurer module`\" + (\" ou depuis le tableau de bord.\" if ui.site_installe() else \".\")",
    "            await ui.erreur(interaction, texte)",
    "            return False",
    "        return True",
    "",
    "",
    "intents = discord.Intents.all()",
    "bot = commands.Bot(command_prefix=PREFIX, intents=intents, help_command=None, tree_cls=Arbre)",
    "ui.bot = bot",
    "",
    "# Suivi du temps vocal actif : {member_id: task}",
    "_voice_tasks = {}",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Démarrage",
    "# ---------------------------------------------------------------------------",
    "",
    "@bot.event",
    "async def setup_hook():",
    "    \"\"\"Appelé UNE SEULE FOIS au démarrage, avant la connexion à Discord.",
    "",
    "    (Tout ceci était dans on_ready, qui se déclenche à CHAQUE reconnexion.)",
    "    \"\"\"",
    "    migres = core.migrer_anciens_fichiers()",
    "    if migres:",
    "        logger.info(f\"{migres} anciens fichiers de données regroupés \"",
    "                    \"(originaux conservés dans data/avant-regroupement/).\")",
    "",
    "    economy.register_economy(bot)",
    "    games.register_game_commands(bot)",
    "    games.register_casino(bot)",
    "    admin.register_admin_commands(bot)",
    "    admin.register_backup(bot)",
    "    admin.register_verify(bot)",
    "    moderation.register_moderation(bot)",
    "    moderation.register_automod(bot)",
    "    community.register_community(bot)",
    "    community.register_extras(bot)",
    "    community.register_tickets(bot)",
    "",
    "    async def _arrivee(member):",
    "        await community.handle_member_join(bot, member)",
    "",
    "    async def _depart(member):",
    "        await community.handle_member_remove(bot, member)",
    "",
    "    bot.add_listener(_arrivee, \"on_member_join\")",
    "    bot.add_listener(_depart, \"on_member_remove\")",
    "",
    "    # Aucune commande n'a de sens en message privé (pas de serveur, donc ni",
    "    # argent ni permissions) : on les cache des MP.",
    "    for commande in bot.tree.get_commands():",
    "        commande.guild_only = True",
    "",
    "    total = len(bot.tree.get_commands())",
    "    logger.info(f\"{total} commandes enregistrées (limite Discord : 100).\")",
    "    if total > 100:",
    "        logger.warning(f\"ATTENTION : {total} commandes > 100. La synchronisation va échouer.\")",
    "",
    "    try:",
    "        await bot.tree.sync()",
    "        logger.info(\"Commandes slash synchronisées avec Discord !\")",
    "    except Exception as e:",
    "        logger.error(f\"Erreur lors de la synchronisation des commandes : {e}\")",
    "",
    "    site = ui.module_site()  # tableau de bord web, s'il est installé (facultatif)",
    "    if site:",
    "        await site.demarrer(bot)",
    "",
    "    for tache in (auto_backup_task, birthday_check_task, auction_check_task,",
    "                  bank_interest_task, data_backup_task, flush_task, statut_task):",
    "        if not tache.is_running():",
    "            tache.start()",
    "",
    "",
    "@tasks.loop(seconds=15)",
    "async def flush_task():",
    "    \"\"\"Filet de sécurité : rien ne traîne en mémoire plus de 15 secondes.\"\"\"",
    "    try:",
    "        core.flush(force=True)",
    "    except Exception as e:",
    "        logger.error(f\"Écriture des données échouée : {e}\")",
    "",
    "",
    "@bot.event",
    "async def on_disconnect():",
    "    core.flush(force=True)",
    "",
    "",
    "@bot.event",
    "async def on_ready():",
    "    logger.info(f\"Bot connecté en tant que {bot.user}\")",
    "    logger.info(f\"Présent sur {len(bot.guilds)} serveur(s).\")",
    "    lien = ui.lien_invitation()",
    "    if lien:",
    "        logger.info(f\"Lien d'invitation : {lien}\")",
    "",
    "",
    "_statuts = itertools.cycle([",
    "    lambda: discord.Activity(type=discord.ActivityType.watching, name=f\"{len(bot.guilds)} serveurs · /help\"),",
    "    lambda: discord.Game(name=\"/daily · /casino · /profil\"),",
    "    lambda: discord.Activity(type=discord.ActivityType.listening,",
    "                             name=ui.lien_site().split(\"://\", 1)[-1] if ui.lien_site() else \"/help\"),",
    "])",
    "",
    "",
    "@tasks.loop(minutes=2)",
    "async def statut_task():",
    "    \"\"\"Statut animé : nombre de serveurs, commandes phares, adresse du site.\"\"\"",
    "    await bot.wait_until_ready()",
    "    try:",
    "        await bot.change_presence(activity=next(_statuts)())",
    "    except Exception:",
    "        pass",
    "",
    "",
    "@tasks.loop(minutes=2)",
    "async def auction_check_task():",
    "    \"\"\"Clôture les enchères dont la date de fin est dépassée.\"\"\"",
    "    for guild in bot.guilds:",
    "        try:",
    "            encheres = core.get_auctions(guild.id)",
    "        except Exception:",
    "            continue",
    "        modifie = False",
    "        for auction_id, enchere in list(encheres.items()):",
    "            if not enchere.get(\"active\"):",
    "                continue",
    "            try:",
    "                fin = datetime.fromisoformat(enchere[\"end_time\"])",
    "            except (KeyError, TypeError, ValueError):",
    "                continue",
    "            if fin > datetime.now():",
    "                continue",
    "            enchere[\"active\"] = False",
    "            modifie = True",
    "            gagnant_id = enchere.get(\"highest_bidder\")",
    "            if gagnant_id:",
    "                core.add_item(guild.id, gagnant_id, enchere[\"item\"])",
    "            salon = guild.system_channel or next(",
    "                (c for c in guild.text_channels if c.permissions_for(guild.me).send_messages), None",
    "            )",
    "            if not salon:",
    "                continue",
    "            embed = ui.embed(f\"🔨 Enchère #{auction_id} terminée\", f\"**{enchere['item']}** est adjugé !\", ui.OR)",
    "            if gagnant_id:",
    "                embed.add_field(name=\"Gagnant\", value=f\"<@{gagnant_id}>\", inline=True)",
    "                embed.add_field(name=\"Prix final\", value=ui.argent(enchere[\"current_bid\"]), inline=True)",
    "                ui.pied(embed, \"L'objet a été ajouté à son inventaire\")",
    "            else:",
    "                embed.description = f\"Aucune offre pour **{enchere['item']}**.\"",
    "            try:",
    "                await salon.send(embed=embed)",
    "            except discord.HTTPException:",
    "                pass",
    "        if modifie:",
    "            core.save_auctions(guild.id, encheres)",
    "",
    "",
    "@tasks.loop(hours=24)",
    "async def bank_interest_task():",
    "    \"\"\"Verse chaque jour des intérêts sur l'argent déposé en banque.\"\"\"",
    "    config = core._config_fusionnee()",
    "    taux = config.get(\"banque_interet_par_jour\", 0.005)",
    "    plafond = config.get(\"banque_interet_plafond\", 5000)",
    "    if taux <= 0:",
    "        return",
    "    for guild in bot.guilds:",
    "        if not core.module_actif(guild.id, \"economie\"):",
    "            continue",
    "        try:",
    "            comptes = core.guild_dict(\"banks\", guild.id)",
    "        except Exception:",
    "            continue",
    "        for user_id, montant in list(comptes.items()):",
    "            if not isinstance(montant, int) or montant <= 0:",
    "                continue",
    "            interets = min(plafond, int(montant * taux))",
    "            if interets > 0:",
    "                core.add_bank(guild.id, user_id, interets)",
    "",
    "",
    "@tasks.loop(hours=12)",
    "async def data_backup_task():",
    "    \"\"\"Copie tous les data/*.json dans data/sauvegardes/ deux fois par jour.\"\"\"",
    "    try:",
    "        core.backup_data_files()",
    "    except Exception as e:",
    "        logger.error(f\"Sauvegarde automatique des données échouée : {e}\")",
    "",
    "",
    "@tasks.loop(hours=6)",
    "async def auto_backup_task():",
    "    \"\"\"Sauvegarde automatique de la structure (rôles/salons) de tous les serveurs.\"\"\"",
    "    await admin.auto_backup_all(bot)",
    "",
    "",
    "@tasks.loop(hours=1)",
    "async def birthday_check_task():",
    "    await community.check_birthdays(bot)",
    "",
    "",
    "def boutons_liens(guild_id=None):",
    "    \"\"\"Boutons « Tableau de bord » / « Inviter » quand le site est configuré.\"\"\"",
    "    vue = discord.ui.View()",
    "    lien = ui.lien_serveur(guild_id) if guild_id else ui.lien_site()",
    "    if lien:",
    "        vue.add_item(discord.ui.Button(label=\"Tableau de bord\", emoji=\"🌐\", url=lien))",
    "    invitation = ui.lien_invitation()",
    "    if invitation:",
    "        vue.add_item(discord.ui.Button(label=\"Inviter le bot\", emoji=\"➕\", url=invitation))",
    "    return vue if vue.children else None",
    "",
    "",
    "@bot.event",
    "async def on_guild_join(guild: discord.Guild):",
    "    \"\"\"Sauvegarde la structure du serveur + message de bienvenue.\"\"\"",
    "    try:",
    "        core.save_backup(guild.id, admin.snapshot(guild))",
    "    except Exception as e:",
    "        logger.error(f\"Sauvegarde initiale impossible pour {guild.name} : {e}\")",
    "    logger.info(f\"Ajouté sur un nouveau serveur : {guild.name} ({guild.member_count} membres)\")",
    "",
    "    embed = ui.embed(",
    "        f\"👋 Merci d'avoir ajouté {bot.user.name} !\",",
    "        \"Je suis un bot **tout-en-un en français** : économie, niveaux, casino, jeux, \"",
    "        \"modération, journal, tickets, giveaways…\\n\\n\"",
    "        \"**Pour bien démarrer :**\\n\"",
    "        \"📖 `/help` — toutes les commandes\\n\"",
    "        \"⚙️ `/configurer voir` — l'état de la configuration\\n\"",
    "        + (\"🌐 Le **tableau de bord** web pour tout régler en quelques clics\\n\" if ui.site_installe() else \"\")",
    "        + \"\\n*Tout est désactivé par défaut côté modération : rien ne change sur ton serveur tant que tu n'as rien configuré.*\",",
    "        ui.PRINCIPAL,",
    "    )",
    "    if bot.user:",
    "        embed.set_thumbnail(url=bot.user.display_avatar.url)",
    "    salon = guild.system_channel",
    "    if not salon or not salon.permissions_for(guild.me).send_messages:",
    "        salon = next((c for c in guild.text_channels if c.permissions_for(guild.me).send_messages), None)",
    "    if salon:",
    "        try:",
    "            vue = boutons_liens(guild.id)",
    "            await salon.send(embed=embed, view=vue) if vue else await salon.send(embed=embed)",
    "        except discord.HTTPException:",
    "            pass",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Suivi vocal actif",
    "# ---------------------------------------------------------------------------",
    "",
    "def _vocal_actif(member: discord.Member, minimum_humains: int) -> tuple[bool, str]:",
    "    \"\"\"Dit si un membre mérite d'être récompensé pour sa minute de vocal",
    "    (pas en sourdine, pas AFK, pas seul) — sinon on farmait en dormant.\"\"\"",
    "    etat = member.voice",
    "    if not etat or not etat.channel:",
    "        return False, \"déconnecté\"",
    "    if etat.self_mute or etat.self_deaf:",
    "        return False, \"en sourdine\"",
    "    if etat.mute or etat.deaf:",
    "        return False, \"muté par un modérateur\"",
    "    salon_afk = member.guild.afk_channel",
    "    if salon_afk and etat.channel.id == salon_afk.id:",
    "        return False, \"dans le salon AFK\"",
    "    humains = [m for m in etat.channel.members if not m.bot]",
    "    if len(humains) < minimum_humains:",
    "        return False, f\"seul ({len(humains)}/{minimum_humains} personnes)\"",
    "    return True, \"actif\"",
    "",
    "",
    "async def _track_voice(member: discord.Member):",
    "    try:",
    "        while True:",
    "            await asyncio.sleep(60)",
    "            if not member.voice or not member.voice.channel:",
    "                break",
    "            minimum = core.reglage(member.guild.id, \"vocal_min_humains\", 2)",
    "            actif, _raison = _vocal_actif(member, minimum)",
    "            if actif:",
    "                await economy.award_voice_minute(member)",
    "    except asyncio.CancelledError:",
    "        pass",
    "    except Exception as e:",
    "        logger.error(f\"Suivi vocal de {member} interrompu : {e}\")",
    "    finally:",
    "        _voice_tasks.pop(member.id, None)",
    "",
    "",
    "def _demarrer_suivi(member: discord.Member):",
    "    if member.bot or member.id in _voice_tasks:",
    "        return",
    "    _voice_tasks[member.id] = asyncio.create_task(_track_voice(member))",
    "",
    "",
    "@bot.event",
    "async def on_voice_state_update(member: discord.Member, before: discord.VoiceState, after: discord.VoiceState):",
    "    if member.bot:",
    "        return",
    "    await community.handle_voice_update(bot, member, before, after)",
    "    if after.channel:",
    "        _demarrer_suivi(member)",
    "        for autre in after.channel.members:",
    "            _demarrer_suivi(autre)",
    "    if not after.channel and member.id in _voice_tasks:",
    "        _voice_tasks[member.id].cancel()",
    "        _voice_tasks.pop(member.id, None)",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Messages : automod, récompenses et commandes rapides à préfixe (-ban, -clear…)",
    "# ---------------------------------------------------------------------------",
    "",
    "async def _confirmer(channel, texte, couleur=None, supprimer=None):",
    "    try:",
    "        await channel.send(embed=ui.embed(description=texte, couleur=couleur or ui.SUCCES), delete_after=supprimer)",
    "    except discord.HTTPException:",
    "        pass",
    "",
    "",
    "async def _prefixe_sanction(message, action, parts):",
    "    if not message.mentions:",
    "        usage = {\"ban\": \"-ban @membre <raison>\", \"kick\": \"-kick @membre <raison>\",",
    "                 \"timeout\": \"-mute @membre <minutes> <raison>\", \"warn\": \"-warn @membre <raison>\"}[action]",
    "        await _confirmer(message.channel, f\"❌ Utilisation : `{usage}`\", ui.ERREUR)",
    "        return",
    "    cible = message.mentions[0]",
    "    if not isinstance(cible, discord.Member) or cible.id == message.author.id:",
    "        await _confirmer(message.channel, \"❌ Cible invalide.\", ui.ERREUR)",
    "        return",
    "    minutes = None",
    "    if action == \"timeout\":",
    "        try:",
    "            minutes = max(1, min(40320, int(parts[2])))",
    "        except (IndexError, ValueError):",
    "            await _confirmer(message.channel, \"❌ Utilisation : `-mute @membre <minutes> <raison>`\", ui.ERREUR)",
    "            return",
    "        raison = parts[3] if len(parts) > 3 else \"Mute rapide\"",
    "    else:",
    "        raison = \" \".join(parts[2:]) if len(parts) > 2 else \"Aucune raison fournie\"",
    "    try:",
    "        texte = await moderation.appliquer_sanction(bot, message.guild, message.author, cible, action, raison[:300], minutes=minutes)",
    "    except PermissionError as e:",
    "        await _confirmer(message.channel, f\"❌ {e}\", ui.ERREUR)",
    "        return",
    "    except discord.HTTPException:",
    "        await _confirmer(message.channel, \"❌ Je n'ai pas la permission de faire ça.\", ui.ERREUR)",
    "        return",
    "    await _confirmer(message.channel, texte, moderation.ACTIONS[action][2])",
    "",
    "",
    "async def _commande_prefixe(message):",
    "    \"\"\"Commandes rapides réservées aux admins. Renvoie True si traitée.\"\"\"",
    "    content = message.content.strip()",
    "    lowered = content.lower()",
    "    if not lowered.startswith(\"-\"):",
    "        return False",
    "    mot = lowered.split()[0]",
    "    connues = {\"-hide\", \"-show\", \"-clear\", \"-ban\", \"-kick\", \"-mute\", \"-warn\", \"-say\", \"-lock\", \"-unlock\",",
    "               \"-slow\", \"-addrole\", \"-removerole\"}",
    "    if mot not in connues:",
    "        return False",
    "    if not core.is_admin(message.author):",
    "        await _confirmer(message.channel, \"❌ Tu n'as pas la permission d'utiliser cette commande.\", ui.ERREUR, 8)",
    "        return True",
    "    channel = message.channel",
    "    everyone = message.guild.default_role",
    "    parts = content.split(maxsplit=3)",
    "",
    "    if mot in (\"-hide\", \"-show\", \"-say\", \"-clear\"):",
    "        try:",
    "            await message.delete()",
    "        except discord.HTTPException:",
    "            pass",
    "",
    "    if mot == \"-hide\":",
    "        await channel.set_permissions(everyone, view_channel=False)",
    "        await _confirmer(channel, \"🙈 Salon caché aux membres.\", supprimer=5)",
    "    elif mot == \"-show\":",
    "        await channel.set_permissions(everyone, view_channel=True)",
    "        await _confirmer(channel, \"👀 Salon de nouveau visible.\", supprimer=5)",
    "    elif mot == \"-clear\":",
    "        try:",
    "            nombre = max(1, min(100, int(content.split()[1])))",
    "        except (IndexError, ValueError):",
    "            await _confirmer(channel, \"❌ Utilisation : `-clear <nombre>` (1 à 100).\", ui.ERREUR, 8)",
    "            return True",
    "        deleted = await channel.purge(limit=nombre)",
    "        await _confirmer(channel, f\"🧹 **{len(deleted)}** message(s) supprimé(s).\", supprimer=5)",
    "    elif mot in (\"-ban\", \"-kick\", \"-warn\"):",
    "        await _prefixe_sanction(message, mot[1:], content.split(maxsplit=2))",
    "    elif mot == \"-mute\":",
    "        await _prefixe_sanction(message, \"timeout\", parts)",
    "    elif mot == \"-say\":",
    "        texte = content[5:].strip()",
    "        if texte:",
    "            await channel.send(texte, allowed_mentions=discord.AllowedMentions(everyone=False, roles=False))",
    "    elif mot == \"-lock\":",
    "        await channel.set_permissions(everyone, send_messages=False)",
    "        await _confirmer(channel, \"🔒 Salon verrouillé, les membres ne peuvent plus écrire.\", ui.ERREUR)",
    "    elif mot == \"-unlock\":",
    "        await channel.set_permissions(everyone, send_messages=None)",
    "        await _confirmer(channel, \"🔓 Salon déverrouillé, les membres peuvent à nouveau écrire.\")",
    "    elif mot == \"-slow\":",
    "        try:",
    "            secondes = max(0, min(21600, int(content.split()[1])))",
    "        except (IndexError, ValueError):",
    "            await _confirmer(channel, \"❌ Utilisation : `-slow <secondes>` (0 pour désactiver).\", ui.ERREUR, 8)",
    "            return True",
    "        await channel.edit(slowmode_delay=secondes)",
    "        await _confirmer(channel, \"🐇 Mode lent désactivé.\" if secondes == 0 else f\"🐢 Mode lent : **{ui.duree(secondes)}**.\")",
    "    elif mot in (\"-addrole\", \"-removerole\"):",
    "        if not message.mentions:",
    "            await _confirmer(channel, f\"❌ Utilisation : `{mot} @membre`.\", ui.ERREUR, 8)",
    "            return True",
    "        mode = \"add\" if mot == \"-addrole\" else \"remove\"",
    "        cible = message.mentions[0]",
    "        await channel.send(embed=admin.embed_role(cible, mode), view=admin.RoleAddRemoveView(message.author, cible, mode))",
    "    return True",
    "",
    "",
    "@bot.event",
    "async def on_message(message: discord.Message):",
    "    if message.author.bot:",
    "        return",
    "    if message.guild is None:",
    "        await bot.process_commands(message)",
    "        return",
    "    # L'automod passe en premier : un message supprimé ne rapporte rien.",
    "    if await moderation.handle_message(bot, message):",
    "        return",
    "    try:",
    "        if await _commande_prefixe(message):",
    "            return",
    "    except discord.HTTPException as e:",
    "        logger.error(f\"Commande rapide échouée : {e}\")",
    "        return",
    "    await economy.award_message(message.author, message.channel)",
    "    await bot.process_commands(message)",
    "",
