    "# ---------------------------------------------------------------------------",
    "# /ping, /botinfo, /setup-server (+ /dashboard si le site est installé)",
    "# ---------------------------------------------------------------------------",
    "",
    "_demarrage = datetime.now()",
    "",
    "",
    "def latence_ms():",
    "    \"\"\"Latence en ms (None tant que le premier battement n'a pas eu lieu).\"\"\"",
    "    latence = bot.latency",
    "    return None if latence != latence or latence == float(\"inf\") else round(latence * 1000)",
    "",
    "",
    "@bot.tree.command(name=\"ping\", description=\"🏓 Latence du bot\")",
    "async def ping_command(interaction: discord.Interaction):",
    "    latence = latence_ms()",
    "    if latence is None:",
    "        await interaction.response.send_message(embed=ui.embed(description=\"🏓 Pong ! (connexion en cours…)\", couleur=ui.PRINCIPAL))",
    "        return",
    "    qualite = \"🟢\" if latence < 150 else (\"🟠\" if latence < 400 else \"🔴\")",
    "    await interaction.response.send_message(embed=ui.embed(description=f\"🏓 Pong ! {qualite} **{latence} ms**\", couleur=ui.PRINCIPAL))",
    "",
    "",
    "@bot.tree.command(name=\"botinfo\", description=\"🤖 Informations sur le bot\")",
    "async def botinfo(interaction: discord.Interaction):",
    "    embed = ui.embed(f\"🤖 {bot.user.name}\", \"Bot tout-en-un en français : économie, niveaux, casino, modération, journal, tickets.\",",
    "                     ui.PRINCIPAL)",
    "    embed.set_thumbnail(url=bot.user.display_avatar.url)",
    "    membres = sum(g.member_count or 0 for g in bot.guilds)",
    "    embed.add_field(name=\"🏠 Serveurs\", value=ui.nombre(len(bot.guilds)), inline=True)",
    "    embed.add_field(name=\"👥 Membres\", value=ui.nombre(membres), inline=True)",
    "    embed.add_field(name=\"⌨️ Commandes\", value=str(len(bot.tree.get_commands())), inline=True)",
    "    embed.add_field(name=\"📡 Latence\", value=f\"{latence_ms()} ms\" if latence_ms() is not None else \"—\", inline=True)",
    "    embed.add_field(name=\"⏱️ En ligne depuis\", value=core.discord_timestamp(_demarrage), inline=True)",
    "    embed.add_field(name=\"🐍 discord.py\", value=discord.__version__, inline=True)",
    "    vue = boutons_liens()",
    "    await interaction.response.send_message(embed=embed, view=vue) if vue else await interaction.response.send_message(embed=embed)",
    "",
    "",
    "# /dashboard n'existe que si le tableau de bord web est installé (src/dashboard.json).",
    "if ui.site_installe():",
    "    @bot.tree.command(name=\"dashboard\", description=\"🌐 Lien du tableau de bord web (configurer le bot en quelques clics)\")",
    "    async def dashboard_command(interaction: discord.Interaction):",
    "        site = ui.lien_site()",
    "        if not site:",
    "            await ui.erreur(",
    "                interaction,",
    "                \"Le tableau de bord n'est pas en ligne sur cette installation du bot.\\n\"",
    "                \"*Propriétaire du bot : renseigne `DASHBOARD_URL` et `CLIENT_SECRET` dans le fichier `.env`.*\",",
    "            )",
    "            return",
    "        admin_serveur = interaction.user.guild_permissions.manage_guild",
    "        embed = ui.embed(",
    "            \"🌐 Tableau de bord\",",
    "            \"Connecte-toi avec Discord pour configurer le bot : modules, économie, niveaux, \"",
    "            \"bienvenue, journal, automod, boutique, tickets…\" if admin_serveur else",
    "            \"Connecte-toi avec Discord pour voir les classements de tes serveurs et ajouter le bot ailleurs.\",",
    "            ui.PRINCIPAL,",
    "        )",
    "        await interaction.response.send_message(embed=embed, view=boutons_liens(interaction.guild_id if admin_serveur else None),",
    "                                                ephemeral=True)",
    "",
    "",
    "@bot.tree.command(name=\"setup-server\", description=\"[Admin] Créer une structure de base : règles, annonces, général\")",
    "async def setup_server(interaction: discord.Interaction):",
    "    if not core.is_admin(interaction.user):",
    "        await ui.erreur(interaction, \"Tu n'as pas la permission d'utiliser cette commande.\")",
    "        return",
    "    await interaction.response.defer(ephemeral=True)",
    "    guild = interaction.guild",
    "    created = []",
    "",
    "    async def get_or_create_category(name):",
    "        cat = discord.utils.get(guild.categories, name=name)",
    "        if not cat:",
    "            cat = await guild.create_category(name=name)",
    "            created.append(f\"📁 {name}\")",
    "        return cat",
    "",
    "    async def get_or_create_text(name, category, topic=None, content=None):",
    "        chan = discord.utils.get(guild.text_channels, name=name.split(\"・\", 1)[-1]) or \\",
    "            discord.utils.get(guild.text_channels, name=name)",
    "        if not chan:",
    "            chan = await guild.create_text_channel(name=name, category=category, topic=topic)",
    "            created.append(f\"💬 {name}\")",
    "            if content:",
    "                await chan.send(embed=content)",
    "        return chan",
    "",
    "    cat_info = await get_or_create_category(\"📌 INFORMATIONS\")",
    "    await get_or_create_text(\"📜・règles\", cat_info, topic=\"Les règles du serveur\", content=ui.embed(",
    "        \"📜 Règles du serveur\",",
    "        \"**1. Respect** — sois respectueux envers tous les membres.\\n\"",
    "        \"**2. Pas de spam** — pas de messages répétitifs.\\n\"",
    "        \"**3. Pas de contenu inapproprié** — rien de NSFW ou d'offensant.\\n\"",
    "        \"**4. Pas de publicité** — sans autorisation du staff.\\n\"",
    "        \"**5. Les bons salons** — chaque sujet à sa place.\\n\\n\"",
    "        \"⚠️ Tout manquement peut entraîner des sanctions.\",",
    "        ui.PRINCIPAL,",
    "    ))",
    "    await get_or_create_text(\"📣・annonces\", cat_info, topic=\"Annonces officielles du serveur\",",
    "                             content=ui.embed(\"📢 Annonces\", \"Les annonces officielles du serveur arriveront ici.\", ui.PRINCIPAL))",
    "    cat_general = await get_or_create_category(\"💬 GÉNÉRAL\")",
    "    await get_or_create_text(\"💬・général\", cat_general, topic=\"Discussion générale\",",
    "                             content=ui.embed(\"🗣️ Bienvenue !\", \"Le salon pour discuter de tout et de rien.\", ui.PRINCIPAL))",
    "    if not discord.utils.get(guild.roles, name=\"Membre\"):",
    "        await guild.create_role(name=\"Membre\")",
    "        created.append(\"🎭 Rôle Membre\")",
    "",
    "    if created:",
    "        await interaction.followup.send(embed=ui.embed(\"✅ Serveur configuré\", \"\\n\".join(f\"• {c}\" for c in created), ui.SUCCES),",
    "                                        ephemeral=True)",
    "    else:",
    "        await interaction.followup.send(embed=ui.embed(description=\"✅ Le serveur avait déjà tous les éléments.\", couleur=ui.SUCCES),",
    "                                        ephemeral=True)",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Gestion des erreurs",
    "# ---------------------------------------------------------------------------",
    "",
    "@bot.event",
    "async def on_command_error(ctx, error):",
    "    if isinstance(error, commands.CommandNotFound):",
    "        return",
    "    logger.error(f\"Erreur de commande : {error}\")",
    "",
    "",
    "@bot.tree.error",
    "async def on_app_command_error(interaction: discord.Interaction, error: app_commands.AppCommandError):",
    "    if isinstance(error, app_commands.CheckFailure) and not isinstance(error, app_commands.BotMissingPermissions):",
    "        return  # déjà géré (message envoyé par le contrôle)",
    "    if isinstance(error, app_commands.BotMissingPermissions):",
    "        texte = \"Il me manque des permissions : \" + \", \".join(error.missing_permissions)",
    "    elif isinstance(error, app_commands.CommandOnCooldown):",
    "        texte = f\"Doucement ! Réessaie dans {ui.duree(error.retry_after)}.\"",
    "    elif isinstance(error, app_commands.CommandInvokeError) and isinstance(error.original, discord.Forbidden):",
    "        texte = \"Je n'ai pas la permission de faire ça (vérifie mes rôles et la hiérarchie).\"",
    "    else:",
    "        logger.error(f\"Erreur de commande slash /{interaction.command.qualified_name if interaction.command else '?'} : {error}\",",
    "                     exc_info=getattr(error, \"original\", error))",
    "        texte = \"Une erreur est survenue. Réessaie plus tard.\"",
    "    await ui.erreur(interaction, texte)",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Lancement",
    "# ---------------------------------------------------------------------------",
    "",
    "if __name__ == \"__main__\":",
    "    if not TOKEN:",
    "        raise SystemExit(\"❌ TOKEN manquant dans le fichier .env\")",
    "    bot.run(TOKEN, log_handler=None)",
    ""
  ]
}
