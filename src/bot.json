    "def _embed_categorie(cat, guild):",
    "    cle, emoji, titre, description, admin_only, sections = cat",
    "    embed = ui.embed(f\"{emoji} {titre}\", f\"*{description}*\", ui.ERREUR if admin_only else ui.PRINCIPAL)",
    "    for nom, lignes in sections:",
    "        embed.add_field(name=nom, value=\"\\n\".join(lignes), inline=False)",
    "    if guild and guild.icon:",
    "        embed.set_thumbnail(url=guild.icon.url)",
    "    ui.pied(embed, \"🔒 Réservé aux administrateurs\" if admin_only else \"Change de catégorie avec le menu\")",
    "    return embed",
    "",
    "",
    "def _embed_accueil(guild, is_admin, categories):",
    "    embed = ui.embed(",
    "        \"📖 Centre d'aide\",",
    "        \"Choisis une catégorie dans le menu ci-dessous.\\n\"",
    "        \"*Astuce : tape `/` dans un salon, Discord te montre toutes les commandes avec leur description.*\",",
    "        ui.PRINCIPAL,",
    "    )",
    "    lignes = []",
    "    for cle, emoji, titre, desc, admin_only, _ in categories:",
    "        if admin_only and not is_admin:",
    "            continue",
    "        lignes.append(f\"{emoji} **{titre}** — {desc}\")",
    "    embed.add_field(name=\"Catégories\", value=\"\\n\".join(lignes), inline=False)",
    "    embed.add_field(",
    "        name=\"⚡ Les plus utilisées\",",
    "        value=\"`/profil` · `/daily` · `/travailler` · `/box` · `/classement`\\n\"",
    "              \"`/casino slots` · `/crime` · `/peche` · `/cooldowns`\",",
    "        inline=False,",
    "    )",
    "    if bot.user:",
    "        embed.set_thumbnail(url=bot.user.display_avatar.url)",
    "    ui.pied(embed, \"Tu es administrateur\" if is_admin else \"Menu adapté à tes permissions\")",
    "    return embed",
    "",
    "",
    "class SelecteurAide(discord.ui.Select):",
    "    def __init__(self, categories, is_admin, guild):",
    "        self.categories = categories",
    "        self.is_admin = is_admin",
    "        self.guild = guild",
    "        options = [discord.SelectOption(label=\"Accueil\", value=\"__accueil__\", emoji=\"🏠\",",
    "                                        description=\"Vue d'ensemble\", default=True)]",
    "        for cle, emoji, titre, desc, admin_only, _ in categories:",
    "            if admin_only and not is_admin:",
    "                continue",
    "            options.append(discord.SelectOption(label=titre, value=cle, emoji=emoji, description=desc[:100]))",
    "        super().__init__(placeholder=\"📂 Choisis une catégorie…\", options=options, row=0)",
    "",
    "    async def callback(self, interaction: discord.Interaction):",
    "        choix = self.values[0]",
    "        for option in self.options:",
    "            option.default = option.value == choix",
    "        if choix == \"__accueil__\":",
    "            embed = _embed_accueil(self.guild, self.is_admin, self.categories)",
    "        else:",
    "            embed = _embed_categorie(next(c for c in self.categories if c[0] == choix), self.guild)",
    "        await interaction.response.edit_message(embed=embed, view=self.view)",
    "",
    "",
    "class HelpView(discord.ui.View):",
    "    def __init__(self, categories, is_admin, guild, auteur_id):",
    "        super().__init__(timeout=300)",
    "        self.auteur_id = auteur_id",
    "        self.add_item(SelecteurAide(categories, is_admin, guild))",
    "        liens = boutons_liens(guild.id if guild and is_admin else None)",
    "        for bouton in (liens.children if liens else []):",
    "            bouton.row = 1",
    "            self.add_item(bouton)",
    "        site = ui.lien_site()",
    "        if site:",
    "            self.add_item(discord.ui.Button(label=\"Toutes les commandes\", emoji=\"📚\", url=f\"{site}/commandes\", row=1))",
    "",
    "    async def interaction_check(self, interaction: discord.Interaction) -> bool:",
    "        if interaction.user.id != self.auteur_id:",
    "            await ui.erreur(interaction, \"Ouvre ton propre `/help` pour naviguer.\")",
    "            return False",
    "        return True",
    "",
    "",
    "@bot.tree.command(name=\"help\", description=\"📖 L'aide complète du bot, par catégorie\")",
    "async def help_command(interaction: discord.Interaction):",
    "    is_admin = core.is_admin(interaction.user)",
    "    categories = _categories_aide(core.get_guild_settings(interaction.guild_id))",
    "    await interaction.response.send_message(",
    "        embed=_embed_accueil(interaction.guild, is_admin, categories),",
    "        view=HelpView(categories, is_admin, interaction.guild, interaction.user.id),",
    "        ephemeral=True,",
    "    )",
    "",
