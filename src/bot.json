    "            (\"Économie\", [",
    "                \"`/argent ajouter|definir|retirer` · `/cooldown-admin`\",",
    "                \"`/box-config ajouter|retirer|prix` · `/shop-config` · `/roles-boutique ajouter`\",",
    "                \"`/mission creer` · `/enchere lancer|terminer` · `/giveaway` · `/drop`\",",
    "            ]),",
    "            (\"Outils\", [",
    "                \"`/ticket panel` — tickets avec transcription · `/setup-role` — rôles à boutons\",",
    "                \"`/sauvegarde creer|restaurer` · `/antiraid verrouiller|deverrouiller`\",",
    "                \"`/annoncer` · `/say` · `/addrole` · `/removerole` · `/setup-server` · `/nettoyer-donnees`\",",
    "            ]),",
    "        ]),",
