    "        ]),",
    "        (\"jeux\", \"🎮\", \"Jeux & Casino\", \"Défier des membres, parier, s'amuser\", False, [",
    "            (\"Contre un membre (mise optionnelle)\", [",
    "                \"`/morpion` · `/puissance4` · `/chifoumi` (ou contre le bot)\",",
    "                \"`/bet-coin` — pile ou face · `/bet-roll` — lancer de dé\",",
    "            ]),",
    "            (\"Solo\", [\"`/devine-nombre` — trouve le nombre entre 1 et 100\"]),",
    "            (\"🎰 Casino\", [",
    "                \"`/casino slots` — jusqu'à **×75** · `/casino blackjack` — avec « doubler »\",",
    "                \"`/casino roulette` — jusqu'à **×36** · `/casino pile-face` · `/casino des`\",",
    "                \"`/casino regles` — tous les gains\",",
    "            ]),",
    "        ]),",
    "        (\"social\", \"💬\", \"Communauté & outils\", \"Profil, sondages, rappels, infos\", False, [",
    "            (\"Profil & infos\", [",
    "                \"`/profil` · `/niveau` · `/userinfo` · `/avatar`\",",
    "                \"`/server-info` · `/emojis` · `/botinfo` · `/ping`\",",
    "            ]),",
