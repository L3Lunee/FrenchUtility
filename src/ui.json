{
  "module": "ui",
  "language": "python",
  "description": "Interface Discord : couleurs, embeds, barres de progression, formatage des nombres et des montants.",
  "entrypoint": false,
  "source": [
    "# ui.py - Identité visuelle du bot dans Discord : couleurs, embeds, barres de",
    "# progression, formatage des nombres et réponses d'erreur / de succès.",
    "#",
    "# Avant, chaque commande choisissait sa couleur et son format à la main :",
    "# des montants bruts (\"1234567 💵\"), des erreurs en texte brut, des couleurs",
    "# différentes pour la même chose. Tout passe maintenant par ici.",
    "",
    "import os",
    "import urllib.parse",
    "",
    "import discord",
    "",
    "# Couleurs du thème.",
    "PRINCIPAL = discord.Color(0x5B7CFA)",
    "SUCCES = discord.Color(0x3BA55D)",
    "ERREUR = discord.Color(0xED4245)",
    "AVERTISSEMENT = discord.Color(0xF0A020)",
    "OR = discord.Color(0xF1C40F)",
    "NIVEAU = discord.Color(0x9B6DFF)",
    "NEUTRE = discord.Color(0x2B2D31)",
    "",
    "DEVISE = \"💵\"",
    "",
    "# Rempli par bot.py : sert au pied de page des embeds (nom + avatar du bot).",
    "bot = None",
    "",
    "",
    "def nombre(n):",
    "    \"\"\"12345678 -> '12 345 678' (espace fine insécable, comme en français).\"\"\"",
    "    try:",
    "        n = int(n)",
    "    except (TypeError, ValueError):",
    "        return str(n)",
    "    return f\"{n:,}\".replace(\",\", \"\\u202f\")",
    "",
    "",
    "def decimal(x, chiffres=1):",
    "    \"\"\"1.5 -> '1,5' (virgule décimale à la française).\"\"\"",
    "    return f\"{x:.{chiffres}f}\".replace(\".\", \",\")",
    "",
    "",
    "def argent(n, gras=True):",
    "    \"\"\"Montant formaté avec la devise : '**12 345** 💵'.\"\"\"",
    "    texte = nombre(n)",
    "    return f\"**{texte}** {DEVISE}\" if gras else f\"{texte} {DEVISE}\"",
    "",
    "",
    "def barre(ratio, longueur=12):",
    "    \"\"\"Barre de progression : ▰▰▰▰▰▱▱▱▱▱▱▱\"\"\"",
    "    ratio = max(0.0, min(1.0, float(ratio or 0)))",
    "    plein = round(ratio * longueur)",
    "    return \"▰\" * plein + \"▱\" * (longueur - plein)",
    "",
    "",
    "def duree(secondes):",
    "    \"\"\"3725 -> '1 h 02 min' ; 45 -> '45 s'.\"\"\"",
    "    secondes = max(0, int(secondes))",
    "    jours, reste = divmod(secondes, 86400)",
    "    heures, reste = divmod(reste, 3600)",
    "    minutes, sec = divmod(reste, 60)",
    "    if jours:",
    "        return f\"{jours} j {heures} h\" if heures else f\"{jours} j\"",
    "    if heures:",
    "        return f\"{heures} h {minutes:02d} min\"",
    "    if minutes:",
    "        return f\"{minutes} min\"",
    "    return f\"{sec} s\"",
    "",
    "",
    "def pied(embed, texte=None):",
    "    \"\"\"Pied de page uniforme : 'FrenchUtility • texte' avec l'avatar du bot.\"\"\"",
    "    nom = bot.user.name if bot is not None and bot.user else \"FrenchUtility\"",
    "    icone = bot.user.display_avatar.url if bot is not None and bot.user else None",
    "    embed.set_footer(text=f\"{nom} • {texte}\" if texte else nom, icon_url=icone)",
    "    return embed",
    "",
    "",
    "def embed(titre=None, description=None, couleur=PRINCIPAL, auteur=None, miniature=None):",
    "    \"\"\"Embed au style du bot. `auteur` : un membre affiché en en-tête.\"\"\"",
    "    e = discord.Embed(title=titre, description=description, color=couleur)",
    "    if auteur is not None:",
    "        e.set_author(name=auteur.display_name, icon_url=auteur.display_avatar.url)",
    "    if miniature:",
    "        e.set_thumbnail(url=miniature)",
    "    return e",
    "",
    "",
    "async def _envoyer(interaction, e, ephemere, view=None):",
    "    kwargs = {\"embed\": e, \"ephemeral\": ephemere}",
    "    if view is not None:",
    "        kwargs[\"view\"] = view",
    "    try:",
    "        if interaction.response.is_done():",
    "            await interaction.followup.send(**kwargs)",
    "        else:",
    "            await interaction.response.send_message(**kwargs)",
    "    except discord.HTTPException:",
    "        pass",
    "",
    "",
    "def _nettoyer(texte, prefixes):",
    "    texte = str(texte).strip()",
    "    for p in prefixes:",
    "        if texte.startswith(p):",
    "            return texte[len(p):].strip()",
    "    return texte",
    "",
    "",
    "async def erreur(interaction, texte, titre=None):",
    "    \"\"\"Réponse d'erreur : embed rouge, visible seulement par l'auteur.\"\"\"",
    "    e = discord.Embed(",
    "        title=titre,",
    "        description=f\"❌ {_nettoyer(texte, ('❌',))}\",",
    "        color=ERREUR,",
    "    )",
    "    await _envoyer(interaction, e, True)",
    "",
    "",
    "async def succes(interaction, texte, titre=None, ephemere=True):",
    "    \"\"\"Réponse de succès : embed vert (éphémère par défaut).\"\"\"",
    "    e = discord.Embed(",
    "        title=titre,",
    "        description=f\"✅ {_nettoyer(texte, ('✅',))}\",",
    "        color=SUCCES,",
    "    )",
    "    await _envoyer(interaction, e, ephemere)",
    "",
    "",
    "async def info(interaction, texte, titre=None, ephemere=True, couleur=PRINCIPAL):",
    "    e = discord.Embed(title=titre, description=texte, color=couleur)",
    "    await _envoyer(interaction, e, ephemere)",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Liens : invitation du bot, et site web s'il est installé. Le site est un",
    "# module facultatif (src/dashboard.json) : sans lui, les boutons qui y mènent",
    "# disparaissent simplement et le bot fonctionne normalement.",
    "# ---------------------------------------------------------------------------",
    "",
    "_site = {\"cherche\": False, \"module\": None}",
    "",
    "",
    "def module_site():",
    "    \"\"\"Le module du site web, ou None s'il n'est pas installé.\"\"\"",
    "    if not _site[\"cherche\"]:",
    "        _site[\"cherche\"] = True",
    "        # On vérifie le fichier d'abord : sans lui, `import dashboard` pourrait",
    "        # tomber sur un paquet pip du même nom.",
    "        if os.path.isfile(os.path.join(\"src\", \"dashboard.json\")):",
    "            try:",
    "                import dashboard",
    "                _site[\"module\"] = dashboard",
    "            except Exception as exc:",
    "                print(f\"[ALERTE] src/dashboard.json présent mais impossible à charger : {exc}\")",
    "    return _site[\"module\"]",
    "",
    "",
    "def site_installe():",
    "    return module_site() is not None",
    "",
    "",
    "def lien_site():",
    "    site = module_site()",
    "    return site.lien_site() if site else None",
    "",
    "",
    "def lien_serveur(guild_id):",
    "    site = module_site()",
    "    return site.lien_serveur(guild_id) if site else None",
    "",
    "",
    "def lien_invitation(guild_id=None):",
    "    \"\"\"Lien pour ajouter le bot sur un serveur (permissions : INVITE_PERMISSIONS, 8 par défaut).\"\"\"",
    "    site = module_site()",
    "    if site:",
    "        return site.lien_invitation(guild_id)",
    "    client_id = os.getenv(\"CLIENT_ID\") or (bot.application_id if bot is not None else None)",
    "    if not client_id:",
    "        return None",
    "    params = {\"client_id\": str(client_id), \"permissions\": os.getenv(\"INVITE_PERMISSIONS\") or \"8\",",
    "              \"scope\": \"bot applications.commands\"}",
    "    if guild_id:",
    "        params.update({\"guild_id\": str(guild_id), \"disable_guild_select\": \"true\"})",
    "    return \"https://discord.com/oauth2/authorize?\" + urllib.parse.urlencode(params, quote_via=urllib.parse.quote)",
    ""
  ]
}
