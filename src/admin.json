{
  "module": "admin",
  "language": "python",
  "description": "Encheres, gestion de l'argent, roles, antiraid, sauvegarde, captcha.",
  "entrypoint": false,
  "source": [
    "# admin.py - Outils d'administration : encheres, gestion de l'argent,",
    "# roles, antiraid, sauvegarde/restauration du serveur et verification",
    "# par captcha a l'arrivee.",
    "",
    "import asyncio",
    "from datetime import datetime, timedelta",
    "import discord",
    "from discord import app_commands",
    "from discord.ext import commands, tasks",
    "import core",
    "",
    "",
    "# =========================================================================",
    "# --- ADMIN ---",
    "# =========================================================================",
    "",
    "# ---------------------------------------------------------------------------",
    "# GUI /setup-role",
    "# ---------------------------------------------------------------------------",
    "",
    "class RoleSelectView(discord.ui.View):",
    "    def __init__(self, guild: discord.Guild, invoker_id: int):",
    "        super().__init__(timeout=180)",
    "        self.guild = guild",
    "        self.invoker_id = invoker_id",
    "        self.selected_role_ids: list[int] = []",
    "        self.mode = \"single\"  # \"single\" ou \"multi\"",
    "",
    "        self.role_select = discord.ui.RoleSelect(",
    "            placeholder=\"Sélectionnez un rôle\", min_values=1, max_values=10",
    "        )",
    "        self.role_select.callback = self.on_role_select",
    "        self.add_item(self.role_select)",
    "",
    "        self.mode_select = discord.ui.Select(",
    "            placeholder=\"Quantité de rôles sélectionnables\",",
    "            options=[",
    "                discord.SelectOption(label=\"Un seul sélectionnable\", value=\"single\", default=True),",
    "                discord.SelectOption(label=\"Plusieurs sélectionnables\", value=\"multi\"),",
    "            ],",
    "        )",
    "        self.mode_select.callback = self.on_mode_select",
    "        self.add_item(self.mode_select)",
    "",
    "        self.confirm_button = discord.ui.Button(label=\"✅ Valider la configuration\", style=discord.ButtonStyle.green)",
    "        self.confirm_button.callback = self.on_confirm",
    "        self.add_item(self.confirm_button)",
    "",
    "    async def _check_invoker(self, interaction: discord.Interaction) -> bool:",
    "        if interaction.user.id != self.invoker_id:",
    "            await interaction.response.send_message(\"❌ Seul l'administrateur ayant lancé la configuration peut agir.\", ephemeral=True)",
    "            return False",
    "        return True",
    "",
    "    async def on_role_select(self, interaction: discord.Interaction):",
    "        if not await self._check_invoker(interaction):",
    "            return",
    "        self.selected_role_ids = [role.id for role in self.role_select.values]",
    "        noms = \", \".join(role.mention for role in self.role_select.values)",
    "        await interaction.response.send_message(f\"✅ Rôles sélectionnés : {noms}\", ephemeral=True)",
    "",
    "    async def on_mode_select(self, interaction: discord.Interaction):",
    "        if not await self._check_invoker(interaction):",
    "            return",
    "        self.mode = self.mode_select.values[0]",
    "        await interaction.response.send_message(",
    "            f\"✅ Mode : {'un seul rôle sélectionnable' if self.mode == 'single' else 'plusieurs rôles sélectionnables'}\",",
    "            ephemeral=True,",
    "        )",
    "",
    "    async def on_confirm(self, interaction: discord.Interaction):",
    "        if not await self._check_invoker(interaction):",
    "            return",
    "        if not self.selected_role_ids:",
    "            await interaction.response.send_message(\"❌ Aucun rôle sélectionnable choisi.\", ephemeral=True)",
    "            return",
    "        core.save_role_setup(self.guild.id, self.selected_role_ids, self.mode)",
    "",
    "        roles = [self.guild.get_role(rid) for rid in self.selected_role_ids]",
    "        roles = [r for r in roles if r is not None]",
    "",
    "        public_view = PublicRoleView(roles, self.mode)",
    "        embed = discord.Embed(",
    "            title=\"📢 Sélection de rôles\",",
    "            description=\"Clique sur les boutons ci-dessous pour obtenir ou retirer un rôle.\",",
    "            color=discord.Color.blurple(),",
    "        )",
    "        await interaction.channel.send(embed=embed, view=public_view)",
    "        await interaction.response.send_message(\"✅ Configuration des rôles publiée !\", ephemeral=True)",
    "        self.stop()",
    "",
    "",
    "class RoleToggleButton(discord.ui.Button):",
    "    def __init__(self, role: discord.Role, mode: str):",
    "        super().__init__(label=role.name, style=discord.ButtonStyle.blurple, custom_id=f\"role_toggle_{role.id}\")",
    "        self.role = role",
    "        self.mode = mode",
    "",
    "    async def callback(self, interaction: discord.Interaction):",
    "        member = interaction.user",
    "        if self.role in member.roles:",
    "            await member.remove_roles(self.role)",
    "            await interaction.response.send_message(f\"❌ Rôle {self.role.mention} retiré.\", ephemeral=True)",
    "            return",
    "",
    "        if self.mode == \"single\":",
    "            view: PublicRoleView = self.view",
    "            to_remove = [r for r in view.roles if r in member.roles]",
    "            if to_remove:",
    "                await member.remove_roles(*to_remove)",
    "",
    "        await member.add_roles(self.role)",
    "        await interaction.response.send_message(f\"✅ Rôle {self.role.mention} attribué !\", ephemeral=True)",
    "",
    "",
    "class PublicRoleView(discord.ui.View):",
    "    def __init__(self, roles: list[discord.Role], mode: str):",
    "        super().__init__(timeout=None)",
    "        self.roles = roles",
    "        self.mode = mode",
    "        for role in roles:",
    "            self.add_item(RoleToggleButton(role, mode))",
    "",
    "",
    "class RoleAddRemoveView(discord.ui.View):",
    "    \"\"\"GUI d'ajout/retrait de rôle avec vérification de hiérarchie (façon DraftBot).\"\"\"",
    "",
    "    def __init__(self, invoker: discord.Member, target: discord.Member, mode: str):",
    "        super().__init__(timeout=60)",
    "        self.invoker = invoker",
    "        self.target = target",
    "        self.mode = mode  # \"add\" ou \"remove\"",
    "",
    "        self.role_select = discord.ui.RoleSelect(",
    "            placeholder=\"Choisis le ou les rôles...\", min_values=1, max_values=10",
    "        )",
    "        self.role_select.callback = self.on_select",
    "        self.add_item(self.role_select)",
    "",
    "    async def interaction_check(self, interaction: discord.Interaction) -> bool:",
    "        if interaction.user.id != self.invoker.id:",
    "            await interaction.response.send_message(\"❌ Ce n'est pas ta commande.\", ephemeral=True)",
    "            return False",
    "        return True",
    "",
    "    async def on_select(self, interaction: discord.Interaction):",
    "        invoker_top = self.invoker.top_role",
    "        applied, rejected = [], []",
    "",
    "        for role in self.role_select.values:",
    "            if role.position >= invoker_top.position or role.managed or role.permissions.administrator:",
    "                rejected.append(role.name)",
    "                continue",
    "            applied.append(role)",
    "",
    "        parts = []",
    "        try:",
    "            if applied:",
    "                if self.mode == \"add\":",
    "                    await self.target.add_roles(*applied, reason=f\"Ajout par {self.invoker}\")",
    "                    verbe = \"ajouté(s)\"",
    "                else:",
    "                    await self.target.remove_roles(*applied, reason=f\"Retrait par {self.invoker}\")",
    "                    verbe = \"retiré(s)\"",
    "                noms = \", \".join(r.mention for r in applied)",
    "                parts.append(f\"✅ Rôle(s) {verbe} à {self.target.mention} : {noms}\")",
    "        except discord.Forbidden:",
    "            parts.append(\"❌ Je n'ai pas la permission de faire ça (vérifie ma position dans la hiérarchie).\")",
    "",
    "        if rejected:",
    "            noms = \", \".join(rejected)",
    "            action = \"ajouter\" if self.mode == \"add\" else \"retirer\"",
    "            parts.append(",
    "                f\"❌ Impossible pour : **{noms}** — vous ne pouvez pas {action} un rôle qui est égal ou plus haut \"",
    "                f\"en hiérarchie de votre rôle le plus haut, ou avec des permissions dangereuses.\"",
    "            )",
    "",
    "        await interaction.response.send_message(\"\\n\".join(parts) or \"❌ Aucun rôle valide sélectionné.\", ephemeral=True)",
    "",
    "",
    "def register_admin_commands(bot: commands.Bot):",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Ajout / retrait de rôle (GUI avec vérification de hiérarchie)",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"addrole\", description=\"[Admin] Ajouter un ou plusieurs rôles à un membre\")",
    "    @core.check_admin()",
    "    async def addrole(interaction: discord.Interaction, membre: discord.Member):",
    "        embed = discord.Embed(",
    "            title=\"➕ Ajout de rôle\",",
    "            description=(",
    "                \"Veuillez choisir le ou les rôles à ajouter ci-dessous\\n\\n\"",
    "                f\"**Cible :** {membre.mention} ({membre.id})\\n\\n\"",
    "                \"⚠️ Vous ne pouvez pas ajouter un rôle qui est égal ou plus haut en hiérarchie de votre \"",
    "                \"rôle le plus haut, ou avec des permissions dangereuses.\"",
    "            ),",
    "            color=discord.Color.blurple(),",
    "        )",
    "        view = RoleAddRemoveView(interaction.user, membre, \"add\")",
    "        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"removerole\", description=\"[Admin] Retirer un ou plusieurs rôles à un membre\")",
    "    @core.check_admin()",
    "    async def removerole(interaction: discord.Interaction, membre: discord.Member):",
    "        embed = discord.Embed(",
    "            title=\"➖ Retrait de rôle\",",
    "            description=(",
    "                \"Veuillez choisir le ou les rôles à retirer ci-dessous\\n\\n\"",
    "                f\"**Cible :** {membre.mention} ({membre.id})\\n\\n\"",
    "                \"⚠️ Vous ne pouvez pas retirer un rôle qui est égal ou plus haut en hiérarchie de votre \"",
    "                \"rôle le plus haut, ou avec des permissions dangereuses.\"",
    "            ),",
    "            color=discord.Color.blurple(),",
    "        )",
    "        view = RoleAddRemoveView(interaction.user, membre, \"remove\")",
    "        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Économie (admin)",
    "    # ------------------------------------------------------------------ #",
    "",
    "    argent_group = app_commands.Group(",
    "        name=\"argent\",",
    "        description=\"💰 Gérer l'argent des membres\",",
    "        default_permissions=discord.Permissions(administrator=True),",
    "    )",
    "    bot.tree.add_command(argent_group)",
    "",
    "    @argent_group.command(name=\"definir\", description=\"Définir le solde d'un membre\")",
    "    @core.check_admin()",
    "    async def setmoney(interaction: discord.Interaction, membre: discord.Member, montant: int):",
    "        old_balance = core.get_wallet(interaction.guild_id, membre.id)",
    "        core.set_wallet(interaction.guild_id, membre.id, montant)",
    "        embed = discord.Embed(title=\"💰 Solde mis à jour\", color=discord.Color.green())",
    "        embed.add_field(name=\"Ancien solde\", value=f\"{old_balance} 💵\", inline=True)",
    "        embed.add_field(name=\"Nouveau solde\", value=f\"{montant} 💵\", inline=True)",
    "        await interaction.response.send_message(embed=embed, ephemeral=True)",
    "",
    "    @argent_group.command(name=\"ajouter\", description=\"Ajouter de l'argent à un membre\")",
    "    @core.check_admin()",
    "    async def addmoney(interaction: discord.Interaction, membre: discord.Member, montant: int):",
    "        old_balance = core.get_wallet(interaction.guild_id, membre.id)",
    "        new_balance = core.add_wallet(interaction.guild_id, membre.id, montant)",
    "        embed = discord.Embed(title=\"💰 Argent ajouté\", color=discord.Color.green())",
    "        embed.add_field(name=\"Ancien solde\", value=f\"{old_balance} 💵\", inline=True)",
    "        embed.add_field(name=\"Nouveau solde\", value=f\"{new_balance} 💵\", inline=True)",
    "        await interaction.response.send_message(embed=embed, ephemeral=True)",
    "",
    "    @argent_group.command(name=\"retirer\", description=\"Retirer de l'argent à un membre\")",
    "    @core.check_admin()",
    "    async def removemoney(interaction: discord.Interaction, membre: discord.Member, montant: int):",
    "        old_balance = core.get_wallet(interaction.guild_id, membre.id)",
    "        if old_balance < montant:",
    "            await interaction.response.send_message(\"❌ L'utilisateur n'a pas assez d'argent.\", ephemeral=True)",
    "            return",
    "        new_balance = core.add_wallet(interaction.guild_id, membre.id, -montant)",
    "        embed = discord.Embed(title=\"💰 Argent retiré\", color=discord.Color.red())",
    "        embed.add_field(name=\"Ancien solde\", value=f\"{old_balance} 💵\", inline=True)",
    "        embed.add_field(name=\"Nouveau solde\", value=f\"{new_balance} 💵\", inline=True)",
    "        await interaction.response.send_message(embed=embed, ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"nettoyer-donnees\", description=\"[Admin] Supprimer les anciennes données de membres qui ne sont plus sur le serveur\")",
    "    @core.check_admin()",
    "    async def nettoyer_donnees(interaction: discord.Interaction):",
    "        await interaction.response.defer(ephemeral=True)",
    "        guild_id = interaction.guild_id",
    "        guild = interaction.guild",
    "",
    "        removed = {\"wallets\": 0, \"banks\": 0, \"stats\": 0, \"levels\": 0, \"antirob\": 0}",
    "",
    "        for name in (\"wallets\", \"banks\", \"stats\", \"levels\", \"antirob\"):",
    "            bucket = core.guild_dict(name, guild_id)",
    "            to_remove = [uid for uid in list(bucket.keys()) if guild.get_member(int(uid)) is None]",
    "            for uid in to_remove:",
    "                del bucket[uid]",
    "                removed[name] += 1",
    "            data = core._load(name)",
    "            data[str(guild_id)] = bucket",
    "            core._save(name, data)",
    "",
    "        total = sum(removed.values())",
    "        if total == 0:",
    "            await interaction.followup.send(\"✅ Aucune donnée fantôme trouvée, tout est propre.\", ephemeral=True)",
    "        else:",
    "            detail = \", \".join(f\"{v} en {k}\" for k, v in removed.items() if v > 0)",
    "            await interaction.followup.send(",
    "                f\"✅ Nettoyage terminé : {total} entrée(s) supprimée(s) ({detail}).\", ephemeral=True",
    "            )",
    "",
    "    @bot.tree.command(name=\"retirer-antirob\", description=\"[Admin] Retirer la protection antirob d'un membre\")",
    "    @core.check_admin()",
    "    async def retirer_antirob(interaction: discord.Interaction, membre: discord.Member):",
    "        had_one = core.clear_antirob(interaction.guild_id, membre.id)",
    "        if had_one:",
    "            await interaction.response.send_message(",
    "                f\"✅ La protection antirob de {membre.mention} a été retirée.\"",
    "            )",
    "        else:",
    "            await interaction.response.send_message(",
    "                f\"❌ {membre.mention} n'avait pas de protection antirob active.\", ephemeral=True",
    "            )",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Enchères",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"auction\", description=\"[Admin] Lancer une enchère\")",
    "    @core.check_admin()",
    "    async def auction(interaction: discord.Interaction, item: str, prix_depart: int, duree_minutes: int = 10):",
    "        guild_id = interaction.guild_id",
    "        auctions = core.get_auctions(guild_id)",
    "        auction_id = str(len(auctions) + 1)",
    "        auctions[auction_id] = {",
    "            \"item\": item,",
    "            \"starting_bid\": prix_depart,",
    "            \"current_bid\": prix_depart,",
    "            \"highest_bidder\": None,",
    "            \"start_time\": datetime.now().isoformat(),",
    "            \"end_time\": (datetime.now() + timedelta(minutes=duree_minutes)).isoformat(),",
    "            \"active\": True,",
    "        }",
    "        core.save_auctions(guild_id, auctions)",
    "",
    "        embed = discord.Embed(",
    "            title=\"🚨 Nouvelle enchère !\",",
    "            description=f\"Une nouvelle enchère a été lancée pour **{item}** !\",",
    "            color=discord.Color.gold(),",
    "        )",
    "        embed.add_field(name=\"Prix de départ\", value=f\"{prix_depart} 💵\", inline=True)",
    "        embed.add_field(name=\"Durée\", value=f\"{duree_minutes} minutes\", inline=True)",
    "        embed.add_field(name=\"Pour enchérir\", value=\"Utilise `/bid <id> <montant>`\", inline=False)",
    "        embed.set_footer(text=f\"ID de l'enchère : {auction_id}\")",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "    @bot.tree.command(name=\"bid\", description=\"Enchérir sur une enchère en cours\")",
    "    async def bid(interaction: discord.Interaction, auction_id: str, montant: int):",
    "        guild_id = interaction.guild_id",
    "        auctions = core.get_auctions(guild_id)",
    "        if auction_id not in auctions:",
    "            await interaction.response.send_message(\"❌ Enchère introuvable.\", ephemeral=True)",
    "            return",
    "",
    "        auction = auctions[auction_id]",
    "        if not auction[\"active\"]:",
    "            await interaction.response.send_message(\"❌ Cette enchère est terminée.\", ephemeral=True)",
    "            return",
    "        if montant <= auction[\"current_bid\"]:",
    "            await interaction.response.send_message(",
    "                f\"❌ Ton enchère doit être supérieure à {auction['current_bid']} 💵.\", ephemeral=True",
    "            )",
    "            return",
    "        balance = core.get_wallet(guild_id, interaction.user.id)",
    "        if balance < montant:",
    "            await interaction.response.send_message(\"❌ Tu n'as pas assez de coins.\", ephemeral=True)",
    "            return",
    "",
    "        if auction[\"highest_bidder\"]:",
    "            core.add_wallet(guild_id, auction[\"highest_bidder\"], auction[\"current_bid\"])",
    "",
    "        auction[\"current_bid\"] = montant",
    "        auction[\"highest_bidder\"] = interaction.user.id",
    "        core.save_auctions(guild_id, auctions)",
    "        core.add_wallet(guild_id, interaction.user.id, -montant)",
    "",
    "        embed = discord.Embed(",
    "            title=\"🔨 Nouvelle enchère !\",",
    "            description=f\"{interaction.user.mention} a enchéri **{montant}** 💵 pour **{auction['item']}** !\",",
    "            color=discord.Color.gold(),",
    "        )",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "    @bot.tree.command(name=\"endauction\", description=\"[Admin] Terminer une enchère\")",
    "    @core.check_admin()",
    "    async def endauction(interaction: discord.Interaction, auction_id: str):",
    "        guild_id = interaction.guild_id",
    "        auctions = core.get_auctions(guild_id)",
    "        if auction_id not in auctions:",
    "            await interaction.response.send_message(\"❌ Enchère introuvable.\", ephemeral=True)",
    "            return",
    "",
    "        auction = auctions[auction_id]",
    "        if not auction[\"active\"]:",
    "            await interaction.response.send_message(\"❌ Cette enchère est déjà terminée.\", ephemeral=True)",
    "            return",
    "",
    "        auction[\"active\"] = False",
    "        core.save_auctions(guild_id, auctions)",
    "",
    "        if auction[\"highest_bidder\"]:",
    "            winner = interaction.guild.get_member(auction[\"highest_bidder\"])",
    "            embed = discord.Embed(",
    "                title=\"🏆 Enchère terminée !\",",
    "                description=f\"L'enchère pour **{auction['item']}** est terminée !\",",
    "                color=discord.Color.green(),",
    "            )",
    "            embed.add_field(name=\"Gagnant\", value=winner.mention if winner else \"Inconnu\", inline=True)",
    "            embed.add_field(name=\"Prix final\", value=f\"{auction['current_bid']} 💵\", inline=True)",
    "            await interaction.response.send_message(embed=embed)",
    "        else:",
    "            await interaction.response.send_message(f\"❌ Aucune enchère n'a été faite pour **{auction['item']}**.\")",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Antiraid",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"creer-antiraid\", description=\"[Admin] Créer un salon antiraid\")",
    "    @core.check_admin()",
    "    async def creer_antiraid(interaction: discord.Interaction):",
    "        guild = interaction.guild",
    "        overwrites = {",
    "            guild.default_role: discord.PermissionOverwrite(read_messages=False),",
    "            guild.me: discord.PermissionOverwrite(read_messages=True),",
    "            interaction.user: discord.PermissionOverwrite(read_messages=True),",
    "        }",
    "        channel = await guild.create_text_channel(",
    "            name=\"antiraid\", overwrites=overwrites, reason=\"Création d'un salon antiraid\"",
    "        )",
    "        await interaction.response.send_message(f\"✅ Salon {channel.mention} créé avec succès !\", ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"ouvrir-antiraid\", description=\"[Admin] Ouvrir le salon antiraid à tout le monde\")",
    "    @core.check_admin()",
    "    async def ouvrir_antiraid(interaction: discord.Interaction):",
    "        channel = discord.utils.get(interaction.guild.text_channels, name=\"antiraid\")",
    "        if channel:",
    "            await channel.set_permissions(interaction.guild.default_role, read_messages=True)",
    "            await interaction.response.send_message(f\"✅ Le salon {channel.mention} est maintenant accessible à tous.\", ephemeral=True)",
    "        else:",
    "            await interaction.response.send_message(\"❌ Aucun salon 'antiraid' trouvé.\", ephemeral=True)",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # /check corrigé (activité vocale fiable)",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"check\", description=\"[Admin] Vérifie des informations sur un utilisateur\")",
    "    @core.check_admin()",
    "    async def check_user(interaction: discord.Interaction, membre: discord.Member = None):",
    "        member = membre or interaction.user",
    "        has_gdv = \"GDV\" in member.display_name.upper()",
    "",
    "        voice_state = member.voice",
    "        if voice_state and voice_state.channel:",
    "            statut = f\"🔊 En vocal dans {voice_state.channel.mention}\"",
    "            if voice_state.self_mute:",
    "                statut += \" (micro coupé)\"",
    "            if voice_state.self_deaf:",
    "                statut += \" (son coupé)\"",
    "            if voice_state.self_stream:",
    "                statut += \" — en direct 🔴\"",
    "        else:",
    "            statut = \"❌ Pas en vocal actuellement\"",
    "",
    "        embed = discord.Embed(title=f\"🔍 Informations sur {member.display_name}\", color=discord.Color.green())",
    "        embed.set_thumbnail(url=member.display_avatar.url)",
    "        embed.add_field(name=\"Pseudo contient GDV\", value=\"✅ Oui\" if has_gdv else \"❌ Non\", inline=True)",
    "        embed.add_field(name=\"Activité vocale\", value=statut, inline=False)",
    "        embed.add_field(name=\"A rejoint le serveur\", value=discord.utils.format_dt(member.joined_at, \"R\") if member.joined_at else \"Inconnu\", inline=True)",
    "        await interaction.response.send_message(embed=embed, ephemeral=True)",
    "",
    "    # ------------------------------------------------------------------ #",
