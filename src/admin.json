    "# =========================================================================",
    "# --- BACKUP ---",
    "# =========================================================================",
    "",
    "def _overwrites_to_list(overwrites):",
    "    result = []",
    "    for target, overwrite in overwrites.items():",
    "        if not isinstance(target, discord.Role):",
    "            continue  # on ne sauvegarde que les permissions par rôle (pas par membre)",
    "        allow, deny = overwrite.pair()",
    "        result.append({\"name\": target.name, \"allow\": allow.value, \"deny\": deny.value})",
    "    return result",
    "",
    "",
    "def snapshot(guild: discord.Guild) -> dict:",
    "    \"\"\"Prend une photo complète de la structure du serveur (rôles, catégories, salons).\"\"\"",
    "    roles = []",
    "    for role in guild.roles:",
    "        if role.is_default() or role.managed:",
    "            continue",
    "        roles.append({",
    "            \"name\": role.name,",
    "            \"color\": role.color.value,",
    "            \"permissions\": role.permissions.value,",
    "            \"hoist\": role.hoist,",
    "            \"mentionable\": role.mentionable,",
    "            \"position\": role.position,",
    "        })",
    "",
    "    categories = []",
    "    for cat in guild.categories:",
    "        categories.append({",
    "            \"name\": cat.name,",
    "            \"position\": cat.position,",
    "            \"overwrites\": _overwrites_to_list(cat.overwrites),",
    "        })",
    "",
    "    channels = []",
    "    for channel in guild.channels:",
    "        if isinstance(channel, discord.CategoryChannel):",
    "            continue",
    "        entry = {",
    "            \"name\": channel.name,",
    "            \"type\": str(channel.type),",
    "            \"category\": channel.category.name if channel.category else None,",
    "            \"position\": channel.position,",
    "            \"overwrites\": _overwrites_to_list(channel.overwrites),",
    "        }",
    "        if isinstance(channel, discord.TextChannel):",
    "            entry[\"topic\"] = channel.topic",
    "            entry[\"nsfw\"] = channel.nsfw",
    "            entry[\"slowmode_delay\"] = channel.slowmode_delay",
    "        elif isinstance(channel, discord.VoiceChannel):",
    "            entry[\"bitrate\"] = channel.bitrate",
    "            entry[\"user_limit\"] = channel.user_limit",
    "        channels.append(entry)",
    "",
    "    return {",
    "        \"guild_name\": guild.name,",
    "        \"saved_at\": datetime.now().isoformat(),",
    "        \"roles\": roles,",
    "        \"categories\": categories,",
    "        \"channels\": channels,",
    "    }",
    "",
    "",
    "async def apply_backup(guild: discord.Guild, data: dict, status_callback=None):",
    "    \"\"\"Recrée uniquement ce qui MANQUE (aucune suppression, aucun doublon).\"\"\"",
    "",
    "    async def status(msg):",
    "        if status_callback:",
    "            await status_callback(msg)",
    "",
    "    # 1. Rôles",
    "    existing_roles = {r.name: r for r in guild.roles}",
    "    role_map = dict(existing_roles)",
    "    created_roles = 0",
    "    for r in sorted(data[\"roles\"], key=lambda x: x[\"position\"]):",
    "        if r[\"name\"] in existing_roles:",
    "            continue",
    "        try:",
    "            new_role = await guild.create_role(",
    "                name=r[\"name\"],",
    "                colour=discord.Colour(r[\"color\"]),",
    "                permissions=discord.Permissions(r[\"permissions\"]),",
    "                hoist=r[\"hoist\"],",
    "                mentionable=r[\"mentionable\"],",
    "                reason=\"Restauration anti-raid\",",
    "            )",
    "            role_map[r[\"name\"]] = new_role",
    "            created_roles += 1",
    "        except discord.HTTPException:",
    "            pass",
    "    await status(f\"✅ Rôles : {created_roles} recréé(s) (sur {len(data['roles'])} sauvegardé(s)).\")",
    "",
    "    def build_overwrites(saved_overwrites):",
    "        overwrites = {}",
    "        for ow in saved_overwrites:",
    "            target = discord.utils.get(guild.roles, name=ow[\"name\"])",
    "            if target is None:",
    "                continue",
    "            overwrites[target] = discord.PermissionOverwrite.from_pair(",
    "                discord.Permissions(ow[\"allow\"]), discord.Permissions(ow[\"deny\"])",
    "            )",
    "        return overwrites",
    "",
    "    # 2. Catégories",
    "    existing_categories = {c.name: c for c in guild.categories}",
    "    category_map = dict(existing_categories)",
    "    created_cats = 0",
    "    for cat in sorted(data[\"categories\"], key=lambda x: x[\"position\"]):",
    "        if cat[\"name\"] in existing_categories:",
    "            continue",
    "        try:",
    "            new_cat = await guild.create_category(",
    "                name=cat[\"name\"],",
    "                overwrites=build_overwrites(cat[\"overwrites\"]),",
    "                reason=\"Restauration anti-raid\",",
    "            )",
    "            category_map[cat[\"name\"]] = new_cat",
    "            created_cats += 1",
    "        except discord.HTTPException:",
    "            pass",
    "    await status(f\"✅ Catégories : {created_cats} recréée(s) (sur {len(data['categories'])} sauvegardée(s)).\")",
    "",
    "    # 3. Salons",
    "    existing_channels = {",
    "        (c.name, str(c.type)) for c in guild.channels if not isinstance(c, discord.CategoryChannel)",
    "    }",
    "    created_channels = 0",
    "    for ch in sorted(data[\"channels\"], key=lambda x: x[\"position\"]):",
    "        key = (ch[\"name\"], ch[\"type\"])",
    "        if key in existing_channels:",
    "            continue",
    "        category = category_map.get(ch[\"category\"]) if ch[\"category\"] else None",
    "        overwrites = build_overwrites(ch[\"overwrites\"])",
    "        try:",
    "            if ch[\"type\"] == \"text\":",
    "                await guild.create_text_channel(",
    "                    name=ch[\"name\"], category=category, overwrites=overwrites,",
    "                    topic=ch.get(\"topic\"), nsfw=ch.get(\"nsfw\", False),",
    "                    slowmode_delay=ch.get(\"slowmode_delay\", 0),",
    "                    reason=\"Restauration anti-raid\",",
    "                )",
    "                created_channels += 1",
    "            elif ch[\"type\"] == \"voice\":",
    "                await guild.create_voice_channel(",
    "                    name=ch[\"name\"], category=category, overwrites=overwrites,",
    "                    bitrate=min(ch.get(\"bitrate\", 64000), guild.bitrate_limit),",
    "                    user_limit=ch.get(\"user_limit\", 0),",
    "                    reason=\"Restauration anti-raid\",",
    "                )",
    "                created_channels += 1",
    "        except discord.HTTPException:",
    "            pass",
    "    await status(f\"✅ Salons : {created_channels} recréé(s) (sur {len(data['channels'])} sauvegardé(s)).\")",
    "",
    "",
    "class RestoreConfirmView(discord.ui.View):",
    "    def __init__(self, invoker_id: int):",
    "        super().__init__(timeout=30)",
    "        self.invoker_id = invoker_id",
    "        self.confirmed = None",
    "",
    "    async def interaction_check(self, interaction: discord.Interaction) -> bool:",
    "        if interaction.user.id != self.invoker_id:",
    "            await interaction.response.send_message(\"❌ Ce n'est pas ta confirmation.\", ephemeral=True)",
    "            return False",
    "        return True",
    "",
    "    @discord.ui.button(label=\"✅ Restaurer\", style=discord.ButtonStyle.green)",
    "    async def confirm(self, interaction: discord.Interaction, button: discord.ui.Button):",
    "        self.confirmed = True",
    "        for c in self.children:",
    "            c.disabled = True",
    "        await interaction.response.edit_message(view=self)",
    "        self.stop()",
    "",
    "    @discord.ui.button(label=\"❌ Annuler\", style=discord.ButtonStyle.red)",
    "    async def cancel(self, interaction: discord.Interaction, button: discord.ui.Button):",
    "        self.confirmed = False",
    "        for c in self.children:",
    "            c.disabled = True",
    "        await interaction.response.edit_message(view=self)",
    "        self.stop()",
    "",
    "",
    "def register_backup(bot: commands.Bot):",
    "",
    "    @bot.tree.command(name=\"backup\", description=\"[Admin] Sauvegarder manuellement la structure du serveur (rôles + salons)\")",
    "    @core.check_admin()",
    "    async def backup_cmd(interaction: discord.Interaction):",
    "        await interaction.response.defer(ephemeral=True)",
    "        data = snapshot(interaction.guild)",
    "        core.save_backup(interaction.guild_id, data)",
    "        await interaction.followup.send(",
    "            f\"✅ Sauvegarde effectuée : **{len(data['roles'])}** rôle(s), \"",
    "            f\"**{len(data['categories'])}** catégorie(s), **{len(data['channels'])}** salon(s).\",",
    "            ephemeral=True,",
    "        )",
    "",
    "    @bot.tree.command(name=\"restaurer\", description=\"[Admin] Restaurer les rôles/salons depuis la dernière sauvegarde\")",
    "    @core.check_admin()",
    "    async def restaurer_cmd(interaction: discord.Interaction):",
    "        data = core.get_backup(interaction.guild_id)",
    "        if not data:",
    "            await interaction.response.send_message(",
    "                \"❌ Aucune sauvegarde trouvée pour ce serveur pour l'instant. Utilise `/backup` d'abord \"",
    "                \"(ou attends la sauvegarde automatique).\",",
    "                ephemeral=True,",
    "            )",
    "            return",
    "",
    "        view = RestoreConfirmView(interaction.user.id)",
    "        await interaction.response.send_message(",
    "            f\"⚠️ Restaurer la sauvegarde du **{data['saved_at']}** \"",
    "            f\"({len(data['roles'])} rôle(s), {len(data['channels'])} salon(s)) ?\\n\"",
    "            f\"Seuls les rôles/salons **manquants** seront recréés (aucune suppression, aucun doublon).\",",
    "            view=view,",
    "            ephemeral=True,",
    "        )",
    "        await view.wait()",
    "        if not view.confirmed:",
    "            await interaction.followup.send(\"❌ Restauration annulée.\", ephemeral=True)",
    "            return",
    "",
    "        messages = []",
    "",
    "        async def report(msg):",
    "            messages.append(msg)",
    "",
    "        await interaction.followup.send(\"⏳ Restauration en cours...\", ephemeral=True)",
    "        await apply_backup(interaction.guild, data, status_callback=report)",
    "        await interaction.followup.send(\"\\n\".join(messages) + \"\\n✅ Restauration terminée !\", ephemeral=True)",
    "",
    "",
    "async def auto_backup_all(bot: commands.Bot):",
    "    \"\"\"Sauvegarde automatiquement tous les serveurs où le bot est présent.\"\"\"",
    "    for guild in bot.guilds:",
    "        try:",
    "            data = snapshot(guild)",
    "            core.save_backup(guild.id, data)",
    "        except Exception as e:",
    "            print(f\"Erreur de sauvegarde auto pour {guild.name} : {e}\")",
    "",
    "",
    "# =========================================================================",
    "# --- VERIFY ---",
    "# =========================================================================",
    "",
    "# Stockage temporaire des mots de vérification en attente : {user_id: mot}",
    "verification_codes = {}",
    "",
    "",
    "def register_verify(bot: commands.Bot):",
    "",
    "    @bot.event",
    "    async def on_member_join(member: discord.Member):",
    "        \"\"\"Envoie un captcha à chaque nouvel arrivant.\"\"\"",
    "        config = core.load_config()",
    "        word = core.generate_captcha()",
    "        verification_codes[member.id] = word",
    "        timeout = config.get(\"captcha_timeout\", 120)",
    "",
    "        verify_channel_id = config.get(\"verify_channel\")",
    "        sent = False",
    "        if verify_channel_id:",
    "            verify_channel = bot.get_channel(verify_channel_id)",
    "            if verify_channel:",
    "                embed = discord.Embed(",
    "                    title=\"🔐 Vérification requise\",",
    "                    description=(",
    "                        f\"Bienvenue sur **{member.guild.name}** ! Pour accéder aux salons, \"",
    "                        f\"utilise `/verifier` et recopie exactement ce mot :\"",
    "                    ),",
    "                    color=discord.Color.blue(),",
    "                )",
    "                embed.add_field(name=\"Mot de vérification\", value=f\"`{word}`\", inline=False)",
    "                embed.set_footer(text=f\"Ce code expire dans {timeout // 60} minute(s).\")",
    "                await verify_channel.send(content=member.mention, embed=embed)",
    "                sent = True",
    "",
    "        if not sent:",
    "            try:",
    "                embed = discord.Embed(",
    "                    title=\"🔐 Vérification requise\",",
    "                    description=(",
    "                        f\"Bienvenue sur **{member.guild.name}** ! Pour accéder aux salons, \"",
    "                        f\"utilise `/verifier` et recopie exactement ce mot :\"",
    "                    ),",
    "                    color=discord.Color.blue(),",
    "                )",
    "                embed.add_field(name=\"Mot de vérification\", value=f\"`{word}`\", inline=False)",
    "                embed.set_footer(text=f\"Ce code expire dans {timeout // 60} minute(s).\")",
    "                await member.send(embed=embed)",
    "            except discord.Forbidden:",
    "                pass",
    "",
    "        asyncio.create_task(verification_timeout(member.id, timeout))",
    "",
    "    async def verification_timeout(member_id, timeout):",
    "        await asyncio.sleep(timeout)",
    "        verification_codes.pop(member_id, None)",
    "",
    "    @bot.tree.command(name=\"verifier\", description=\"Vérifier ton mot de vérification\")",
    "    async def verifier(interaction: discord.Interaction, mot: str):",
    "        if interaction.user.id not in verification_codes:",
    "            await interaction.response.send_message(",
    "                \"❌ Aucune vérification en cours pour toi. Utilise `/renvoyer-verification`.\", ephemeral=True",
    "            )",
    "            return",
    "",
    "        if verification_codes[interaction.user.id].lower() == mot.strip().lower():",
    "            config = core.load_config()",
    "            role_name = config.get(\"verify_role\", \"Membre\")",
    "            role = discord.utils.get(interaction.guild.roles, name=role_name)",
    "            if not role:",
    "                role = await interaction.guild.create_role(name=role_name)",
    "",
    "            await interaction.user.add_roles(role)",
    "            del verification_codes[interaction.user.id]",
    "            await interaction.response.send_message(",
    "                f\"✅ {interaction.user.mention}, tu es maintenant vérifié ! Bienvenue sur le serveur.\", ephemeral=True",
    "            )",
    "        else:",
    "            await interaction.response.send_message(\"❌ Mot invalide. Réessaie.\", ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"renvoyer-verification\", description=\"Renvoyer un nouveau code de vérification\")",
    "    async def renvoyer_verification(interaction: discord.Interaction):",
    "        config = core.load_config()",
    "        timeout = config.get(\"captcha_timeout\", 120)",
    "",
    "        verification_codes.pop(interaction.user.id, None)",
    "        code = core.generate_captcha()",
    "        verification_codes[interaction.user.id] = code",
    "",
    "        try:",
    "            embed = discord.Embed(",
    "                title=\"🔐 Nouveau code de vérification\",",
    "                description=\"Voici ton nouveau code de vérification :\",",
    "                color=discord.Color.blue(),",
    "            )",
    "            embed.add_field(name=\"Mot de vérification\", value=f\"`{code}`\", inline=False)",
    "            embed.set_footer(text=f\"Ce code expire dans {timeout // 60} minute(s).\")",
    "            await interaction.user.send(embed=embed)",
    "            await interaction.response.send_message(\"✅ Un nouveau code t'a été envoyé en MP.\", ephemeral=True)",
    "            asyncio.create_task(verification_timeout(interaction.user.id, timeout))",
    "        except discord.Forbidden:",
    "            await interaction.response.send_message(",
    "                \"❌ Impossible de t'envoyer un MP. Active les messages privés puis réessaie.\", ephemeral=True",
    "            )",
    ""
  ]
}
