{
  "module": "moderation",
  "language": "python",
  "description": "Sanctions, moderation automatique et journal des evenements.",
  "entrypoint": false,
  "source": [
    "# moderation.py - Sanctions manuelles (warn, timeout, ban, slowmode),",
    "# moderation automatique (anti-spam, anti-liens, filtre de mots) et",
    "# journal des evenements du serveur.",
    "",
    "import re",
    "import time",
    "from collections import defaultdict, deque",
    "import discord",
    "from discord import app_commands",
    "import core",
    "from datetime import timedelta",
    "from discord.ext import commands",
    "",
    "",
    "# =========================================================================",
    "# --- MODERATION ---",
    "# =========================================================================",
    "",
    "# ---------------------------------------------------------------------------",
    "# Panneau GUI de modération (/moderer, /mutegui) — raisons + durées via menus",
    "# déroulants au lieu de formulaires texte, avec \"Autre\" pour une raison libre.",
    "# ---------------------------------------------------------------------------",
    "",
    "RAISONS_PRESETS = [",
    "    \"Spam\", \"Insultes envers un membre\", \"Contenu inapproprié / NSFW\",",
    "    \"Non-respect du règlement\", \"Provocation / troll\",",
    "    \"Publicité non autorisée\", \"Autre (préciser)\",",
    "]",
    "",
    "DUREES_MUTE = [",
    "    (\"5 minutes\", 5), (\"10 minutes\", 10), (\"30 minutes\", 30),",
    "    (\"1 heure\", 60), (\"6 heures\", 360), (\"1 jour\", 1440), (\"1 semaine\", 10080),",
    "]",
    "",
    "",
    "class CustomReasonModal(discord.ui.Modal, title=\"Raison personnalisée\"):",
    "    raison = discord.ui.TextInput(label=\"Raison\", style=discord.TextStyle.paragraph, max_length=300)",
    "",
    "    def __init__(self, parent_view: \"ActionConfirmView\"):",
    "        super().__init__()",
    "        self.parent_view = parent_view",
    "",
    "    async def on_submit(self, interaction: discord.Interaction):",
    "        await self.parent_view.apply(interaction, self.raison.value)",
    "",
    "",
    "class ReasonSelect(discord.ui.Select):",
    "    def __init__(self):",
    "        options = [discord.SelectOption(label=r) for r in RAISONS_PRESETS]",
    "        super().__init__(placeholder=\"Choisis une raison...\", options=options)",
    "",
    "    async def callback(self, interaction: discord.Interaction):",
    "        self.view.selected_reason = self.values[0]",
    "        await interaction.response.send_message(f\"✅ Raison sélectionnée : {self.values[0]}\", ephemeral=True)",
    "",
    "",
    "class DurationSelect(discord.ui.Select):",
    "    def __init__(self):",
    "        options = [discord.SelectOption(label=label, value=str(minutes)) for label, minutes in DUREES_MUTE]",
    "        super().__init__(placeholder=\"Choisis une durée...\", options=options)",
    "",
    "    async def callback(self, interaction: discord.Interaction):",
    "        self.view.selected_duration = int(self.values[0])",
    "        label = next(l for l, m in DUREES_MUTE if m == self.view.selected_duration)",
    "        await interaction.response.send_message(f\"✅ Durée sélectionnée : {label}\", ephemeral=True)",
    "",
    "",
    "class ActionConfirmView(discord.ui.View):",
    "    \"\"\"action : 'warn' | 'kick' | 'ban' | 'timeout'. duration_needed=True pour timeout.\"\"\"",
    "",
    "    def __init__(self, invoker: discord.Member, cible: discord.Member, guild_id: int, action: str,",
    "                 duration_needed: bool = False):",
    "        super().__init__(timeout=90)",
    "        self.invoker = invoker",
    "        self.cible = cible",
    "        self.guild_id = guild_id",
    "        self.action = action",
    "        self.selected_reason = None",
    "        self.selected_duration = None",
    "",
    "        self.add_item(ReasonSelect())",
    "        if duration_needed:",
    "            self.add_item(DurationSelect())",
    "",
    "        confirm = discord.ui.Button(label=\"✅ Confirmer\", style=discord.ButtonStyle.red, row=2)",
    "        confirm.callback = self.on_confirm",
    "        self.add_item(confirm)",
    "",
    "    async def interaction_check(self, interaction: discord.Interaction) -> bool:",
    "        if interaction.user.id != self.invoker.id:",
    "            await interaction.response.send_message(\"❌ Ce panneau n'est pas le tien.\", ephemeral=True)",
    "            return False",
    "        return True",
    "",
    "    async def apply(self, interaction: discord.Interaction, reason: str):",
    "        try:",
    "            if self.action == \"warn\":",
    "                count = core.add_warning(self.guild_id, self.cible.id, reason, self.invoker.id)",
    "                core.add_mod_log(self.guild_id, self.cible.id, \"warn\", reason, self.invoker.id)",
    "                msg = f\"⚠️ {self.cible.mention} averti ({count} avertissement(s)). Raison : {reason}\"",
    "            elif self.action == \"kick\":",
    "                await self.cible.kick(reason=reason)",
    "                core.add_mod_log(self.guild_id, self.cible.id, \"kick\", reason, self.invoker.id)",
    "                msg = f\"👢 {self.cible.mention} a été expulsé. Raison : {reason}\"",
    "            elif self.action == \"ban\":",
    "                await self.cible.ban(reason=reason, delete_message_days=0)",
    "                core.add_mod_log(self.guild_id, self.cible.id, \"ban\", reason, self.invoker.id)",
    "                msg = f\"⛔ {self.cible.mention} a été banni. Raison : {reason}\"",
    "            elif self.action == \"timeout\":",
    "                minutes = self.selected_duration or 10",
    "                until = discord.utils.utcnow() + timedelta(minutes=minutes)",
    "                await self.cible.timeout(until, reason=reason)",
    "                core.add_mod_log(self.guild_id, self.cible.id, f\"timeout ({minutes} min)\", reason, self.invoker.id)",
    "                msg = f\"🔇 {self.cible.mention} mis en timeout pour **{minutes}** minute(s). Raison : {reason}\"",
    "            await interaction.response.send_message(msg)",
    "        except discord.Forbidden:",
    "            await interaction.response.send_message(",
    "                \"❌ Je n'ai pas la permission de faire ça (vérifie la hiérarchie des rôles).\", ephemeral=True",
    "            )",
    "        except discord.HTTPException as e:",
    "            await interaction.response.send_message(f\"❌ Erreur Discord : {e}\", ephemeral=True)",
    "",
    "    async def on_confirm(self, interaction: discord.Interaction):",
    "        if not self.selected_reason:",
    "            await interaction.response.send_message(\"❌ Choisis d'abord une raison.\", ephemeral=True)",
    "            return",
    "        if self.action == \"timeout\" and not self.selected_duration:",
    "            await interaction.response.send_message(\"❌ Choisis aussi une durée.\", ephemeral=True)",
    "            return",
    "        if self.selected_reason == \"Autre (préciser)\":",
    "            await interaction.response.send_modal(CustomReasonModal(self))",
    "            return",
    "        await self.apply(interaction, self.selected_reason)",
    "",
    "",
    "class ModerationPanelView(discord.ui.View):",
    "    def __init__(self, membre: discord.Member, guild_id: int, invoker_id: int, invoker: discord.Member):",
    "        super().__init__(timeout=60)",
    "        self.membre = membre",
    "        self.guild_id = guild_id",
    "        self.invoker_id = invoker_id",
    "        self.invoker = invoker",
    "",
    "    async def interaction_check(self, interaction: discord.Interaction) -> bool:",
    "        if interaction.user.id != self.invoker_id:",
    "            await interaction.response.send_message(\"❌ Ce panneau n'est pas le tien.\", ephemeral=True)",
    "            return False",
    "        return True",
    "",
    "    @discord.ui.button(label=\"Avertir\", style=discord.ButtonStyle.blurple, emoji=\"⚠️\")",
    "    async def warn_btn(self, interaction: discord.Interaction, button: discord.ui.Button):",
    "        view = ActionConfirmView(self.invoker, self.membre, self.guild_id, \"warn\")",
    "        await interaction.response.send_message(f\"⚠️ Avertir {self.membre.mention}\", view=view, ephemeral=True)",
    "",
    "    @discord.ui.button(label=\"Timeout\", style=discord.ButtonStyle.grey, emoji=\"🔇\")",
    "    async def timeout_btn(self, interaction: discord.Interaction, button: discord.ui.Button):",
    "        view = ActionConfirmView(self.invoker, self.membre, self.guild_id, \"timeout\", duration_needed=True)",
    "        await interaction.response.send_message(f\"🔇 Timeout {self.membre.mention}\", view=view, ephemeral=True)",
    "",
    "    @discord.ui.button(label=\"Kick\", style=discord.ButtonStyle.grey, emoji=\"👢\")",
    "    async def kick_btn(self, interaction: discord.Interaction, button: discord.ui.Button):",
    "        view = ActionConfirmView(self.invoker, self.membre, self.guild_id, \"kick\")",
    "        await interaction.response.send_message(f\"👢 Expulser {self.membre.mention}\", view=view, ephemeral=True)",
    "",
    "    @discord.ui.button(label=\"Ban\", style=discord.ButtonStyle.red, emoji=\"⛔\")",
    "    async def ban_btn(self, interaction: discord.Interaction, button: discord.ui.Button):",
    "        view = ActionConfirmView(self.invoker, self.membre, self.guild_id, \"ban\")",
    "        await interaction.response.send_message(f\"⛔ Bannir {self.membre.mention}\", view=view, ephemeral=True)",
    "",
    "",
    "def register_moderation(bot: commands.Bot):",
    "",
    "    @bot.tree.command(name=\"moderer\", description=\"[Admin] Ouvrir le panneau de modération pour un membre\")",
    "    @core.check_admin()",
    "    async def moderer(interaction: discord.Interaction, membre: discord.Member):",
    "        embed = discord.Embed(",
    "            title=f\"🛠️ Modération — {membre.display_name}\",",
    "            description=\"Choisis une action ci-dessous, puis une raison (menu déroulant) et confirme.\",",
    "            color=discord.Color.orange(),",
    "        )",
    "        embed.set_thumbnail(url=membre.display_avatar.url)",
    "        view = ModerationPanelView(membre, interaction.guild_id, interaction.user.id, interaction.user)",
    "        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"mutegui\", description=\"[Admin] Panneau GUI de mute avec raisons et durées prédéfinies\")",
    "    @core.check_admin()",
    "    async def mutegui(interaction: discord.Interaction, membre: discord.Member):",
    "        embed = discord.Embed(",
    "            title=f\"🔇 Mute — {membre.display_name}\",",
    "            description=\"Choisis une raison et une durée dans les menus, puis clique sur Confirmer.\",",
    "            color=discord.Color.orange(),",
    "        )",
    "        embed.set_thumbnail(url=membre.display_avatar.url)",
    "        view = ActionConfirmView(interaction.user, membre, interaction.guild_id, \"timeout\", duration_needed=True)",
    "        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Avertissements",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"warn\", description=\"[Admin] Avertir un membre\")",
    "    @core.check_admin()",
    "    async def warn(interaction: discord.Interaction, membre: discord.Member, raison: str):",
    "        count = core.add_warning(interaction.guild_id, membre.id, raison, interaction.user.id)",
    "        core.add_mod_log(interaction.guild_id, membre.id, \"warn\", raison, interaction.user.id)",
    "        await interaction.response.send_message(",
    "            f\"⚠️ {membre.mention} a été averti ({count} avertissement(s) au total). Raison : {raison}\"",
    "        )",
    "",
    "    # /avertir supprimé : c'était un doublon mot pour mot de /warn, et il",
    "    # consommait un slot sur les 100 disponibles pour rien.",
    "",
    "    @bot.tree.command(name=\"effacer-avertissements\", description=\"[Admin] Effacer tous les avertissements d'un membre\")",
    "    @core.check_admin()",
    "    async def effacer_avertissements(interaction: discord.Interaction, membre: discord.Member):",
    "        had = core.clear_warnings(interaction.guild_id, membre.id)",
    "        if had:",
    "            await interaction.response.send_message(f\"✅ Avertissements de {membre.mention} effacés.\", ephemeral=True)",
    "        else:",
    "            await interaction.response.send_message(f\"❌ {membre.mention} n'avait aucun avertissement.\", ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"historique\", description=\"[Admin] Voir tout l'historique de modération d'un membre\")",
    "    @core.check_admin()",
    "    async def historique(interaction: discord.Interaction, membre: discord.Member):",
    "        entries = core.get_mod_log(interaction.guild_id, membre.id)",
    "        if not entries:",
    "            await interaction.response.send_message(f\"❌ {membre.mention} n'a aucun historique de modération.\", ephemeral=True)",
    "            return",
    "",
    "        entries_sorted = sorted(entries, key=lambda e: e[\"date\"], reverse=True)",
    "        emojis = {\"warn\": \"⚠️\", \"ban\": \"⛔\", \"kick\": \"👢\"}",
    "        lines = []",
    "        for e in entries_sorted[:15]:",
    "            emoji = emojis.get(e[\"action\"], \"🔇\" if \"timeout\" in e[\"action\"] else \"📄\")",
    "            mod = interaction.guild.get_member(e[\"moderator_id\"])",
    "            mod_name = mod.display_name if mod else f\"ID {e['moderator_id']}\"",
    "            date_txt = e[\"date\"].split(\"T\")[0]",
    "            lines.append(f\"{emoji} **{e['action']}** — {date_txt} par {mod_name}\\n> {e['reason']}\")",
    "",
    "        embed = discord.Embed(",
    "            title=f\"📋 Historique de modération — {membre.display_name}\",",
    "            description=\"\\n\\n\".join(lines),",
    "            color=discord.Color.orange(),",
    "        )",
    "        embed.set_footer(text=f\"{len(entries)} entrée(s) au total\" + (\" (15 plus récentes affichées)\" if len(entries) > 15 else \"\"))",
    "        await interaction.response.send_message(embed=embed, ephemeral=True)",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Timeout / Ban / Kick / Unban",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"timeout\", description=\"[Admin] Mettre un membre en sourdine temporaire\")",
    "    @core.check_admin()",
    "    async def timeout_cmd(interaction: discord.Interaction, membre: discord.Member, minutes: int,",
    "                           raison: str = \"Aucune raison fournie\"):",
    "        try:",
    "            until = discord.utils.utcnow() + timedelta(minutes=minutes)",
    "            await membre.timeout(until, reason=raison)",
    "            core.add_mod_log(interaction.guild_id, membre.id, f\"timeout ({minutes} min)\", raison, interaction.user.id)",
    "            await interaction.response.send_message(",
    "                f\"🔇 {membre.mention} mis en timeout pour **{minutes}** minute(s). Raison : {raison}\"",
    "            )",
    "        except discord.Forbidden:",
    "            await interaction.response.send_message(\"❌ Je n'ai pas la permission de faire ça.\", ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"untimeout\", description=\"[Admin] Retirer le timeout d'un membre\")",
    "    @core.check_admin()",
    "    async def untimeout_cmd(interaction: discord.Interaction, membre: discord.Member):",
    "        try:",
    "            await membre.timeout(None, reason=f\"Timeout retiré par {interaction.user}\")",
    "            await interaction.response.send_message(f\"✅ Timeout de {membre.mention} retiré.\")",
    "        except discord.Forbidden:",
    "            await interaction.response.send_message(\"❌ Je n'ai pas la permission de faire ça.\", ephemeral=True)",
    "",
    "    @bot.tree.command(name=\"unban\", description=\"[Admin] Débannir un utilisateur via son ID\")",
    "    @core.check_admin()",
    "    async def unban_cmd(interaction: discord.Interaction, user_id: str, raison: str = \"Aucune raison fournie\"):",
    "        try:",
    "            user = await bot.fetch_user(int(user_id))",
    "            await interaction.guild.unban(user, reason=raison)",
    "            core.add_mod_log(interaction.guild_id, user.id, \"unban\", raison, interaction.user.id)",
    "            await interaction.response.send_message(f\"✅ {user.mention} a été débanni.\", ephemeral=True)",
    "        except (discord.NotFound, ValueError):",
    "            await interaction.response.send_message(\"❌ Utilisateur introuvable ou pas banni.\", ephemeral=True)",
    "        except discord.Forbidden:",
    "            await interaction.response.send_message(\"❌ Je n'ai pas la permission de faire ça.\", ephemeral=True)",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Vocal",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"mute-vocal\", description=\"[Admin] Muter/démuter un membre en vocal\")",
    "    @core.check_admin()",
    "    async def mute_vocal(interaction: discord.Interaction, membre: discord.Member):",
    "        if not membre.voice:",
    "            await interaction.response.send_message(\"❌ Ce membre n'est pas en vocal.\", ephemeral=True)",
    "            return",
    "        new_state = not membre.voice.mute",
    "        await membre.edit(mute=new_state)",
    "        await interaction.response.send_message(",
    "            f\"🔇 {membre.mention} est maintenant {'muet' if new_state else 'démuté'} en vocal.\"",
    "        )",
    "",
    "    @bot.tree.command(name=\"déconnecter-vocal\", description=\"[Admin] Déconnecter un membre du vocal\")",
    "    @core.check_admin()",
    "    async def deconnecter_vocal(interaction: discord.Interaction, membre: discord.Member):",
    "        if not membre.voice:",
    "            await interaction.response.send_message(\"❌ Ce membre n'est pas en vocal.\", ephemeral=True)",
    "            return",
    "        await membre.move_to(None)",
    "        await interaction.response.send_message(f\"🔌 {membre.mention} a été déconnecté du vocal.\")",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Salon : verrouillage / mode lent",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"verouiller\", description=\"[Admin] Verrouille/déverrouille ce salon pour les membres\")",
    "    @core.check_admin()",
    "    async def verouiller(interaction: discord.Interaction):",
    "        channel = interaction.channel",
    "        overwrite = channel.overwrites_for(interaction.guild.default_role)",
    "        currently_locked = overwrite.send_messages is False",
    "        overwrite.send_messages = True if currently_locked else False",
    "        await channel.set_permissions(interaction.guild.default_role, overwrite=overwrite)",
    "        if currently_locked:",
    "            await interaction.response.send_message(\"🔓 Salon déverrouillé, les membres peuvent à nouveau écrire.\")",
    "        else:",
    "            await interaction.response.send_message(\"🔒 Salon verrouillé, les membres ne peuvent plus écrire.\")",
    "",
    "    @bot.tree.command(name=\"slowmode\", description=\"[Admin] Définir le mode lent de ce salon (secondes, 0 = désactivé)\")",
    "    @core.check_admin()",
    "    async def slowmode(interaction: discord.Interaction, secondes: app_commands.Range[int, 0, 21600]):",
    "        await interaction.channel.edit(slowmode_delay=secondes)",
    "        if secondes == 0:",
    "            await interaction.response.send_message(\"✅ Mode lent désactivé.\")",
    "        else:",
    "            await interaction.response.send_message(f\"✅ Mode lent réglé sur **{secondes}** seconde(s).\")",
    "",
    "    # ------------------------------------------------------------------ #",
    "    # Informations (publiques)",
    "    # ------------------------------------------------------------------ #",
    "",
    "    @bot.tree.command(name=\"avatar\", description=\"Voir l'avatar d'un membre\")",
    "    async def avatar(interaction: discord.Interaction, membre: discord.Member = None):",
    "        member = membre or interaction.user",
    "        embed = discord.Embed(title=f\"Avatar de {member.display_name}\", color=discord.Color.blurple())",
    "        embed.set_image(url=member.display_avatar.url)",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "    @bot.tree.command(name=\"botinfo\", description=\"Informations sur le bot\")",
    "    async def botinfo(interaction: discord.Interaction):",
    "        embed = discord.Embed(title=\"🤖 Informations sur le bot\", color=discord.Color.blurple())",
    "        embed.add_field(name=\"Nom\", value=str(bot.user), inline=True)",
    "        embed.add_field(name=\"Serveurs\", value=str(len(bot.guilds)), inline=True)",
    "        embed.add_field(name=\"Latence\", value=f\"{round(bot.latency * 1000)}ms\", inline=True)",
    "        if bot.user:",
    "            embed.set_thumbnail(url=bot.user.display_avatar.url)",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "    @bot.tree.command(name=\"server-info\", description=\"Informations sur le serveur\")",
    "    async def server_info(interaction: discord.Interaction):",
    "        guild = interaction.guild",
    "        embed = discord.Embed(title=f\"📊 {guild.name}\", color=discord.Color.blurple())",
    "        if guild.icon:",
    "            embed.set_thumbnail(url=guild.icon.url)",
    "        embed.add_field(name=\"Membres\", value=str(guild.member_count), inline=True)",
    "        embed.add_field(name=\"Salons\", value=str(len(guild.channels)), inline=True)",
    "        embed.add_field(name=\"Rôles\", value=str(len(guild.roles)), inline=True)",
    "        embed.add_field(name=\"Créé le\", value=discord.utils.format_dt(guild.created_at, \"D\"), inline=True)",
    "        embed.add_field(name=\"Propriétaire\", value=str(guild.owner) if guild.owner else \"Inconnu\", inline=True)",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "    @bot.tree.command(name=\"userinfo\", description=\"Informations sur un membre\")",
    "    async def userinfo(interaction: discord.Interaction, membre: discord.Member = None):",
    "        member = membre or interaction.user",
    "        warns = core.get_warnings(interaction.guild_id, member.id)",
    "        embed = discord.Embed(title=f\"👤 {member.display_name}\", color=discord.Color.blurple())",
    "        embed.set_thumbnail(url=member.display_avatar.url)",
    "        embed.add_field(name=\"Compte créé le\", value=discord.utils.format_dt(member.created_at, \"D\"), inline=True)",
    "        embed.add_field(",
    "            name=\"A rejoint le\",",
    "            value=discord.utils.format_dt(member.joined_at, \"D\") if member.joined_at else \"Inconnu\",",
    "            inline=True,",
    "        )",
    "        embed.add_field(name=\"Rôles\", value=str(max(0, len(member.roles) - 1)), inline=True)",
    "        embed.add_field(name=\"Avertissements\", value=str(len(warns)), inline=True)",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "    @bot.tree.command(name=\"emojis\", description=\"Voir tous les emojis personnalisés du serveur\")",
    "    async def emojis_cmd(interaction: discord.Interaction):",
    "        guild = interaction.guild",
    "        if not guild.emojis:",
    "            await interaction.response.send_message(\"❌ Ce serveur n'a aucun emoji personnalisé.\", ephemeral=True)",
    "            return",
    "        text = \" \".join(str(e) for e in guild.emojis)",
    "        embed = discord.Embed(title=f\"😃 Emojis de {guild.name}\", description=text[:4000], color=discord.Color.blurple())",
    "        await interaction.response.send_message(embed=embed)",
    "",
    "",
    "# =========================================================================",
    "# --- AUTOMOD ---",
    "# =========================================================================",
    "",
    "# Historique récent des messages, pour la détection de spam : {(guild, user): [timestamps]}",
    "_historique = defaultdict(lambda: deque(maxlen=12))",
    "",
    "LIEN_RE = re.compile(r\"https?://\\S+\", re.IGNORECASE)",
    "INVITE_RE = re.compile(r\"(discord\\.(gg|io|me|li)|discordapp\\.com/invite)/\\S+\", re.IGNORECASE)",
    "",
    "REGLES = {",
    "    \"spam\": \"Envoi de messages trop rapide\",",
    "    \"liens\": \"Lien non autorisé\",",
    "    \"invitations\": \"Invitation Discord\",",
    "    \"majuscules\": \"Abus de majuscules\",",
    "    \"mots_interdits\": \"Mot interdit\",",
    "    \"mentions\": \"Trop de mentions\",",
    "}",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Journal (logs)",
    "# ---------------------------------------------------------------------------",
    "",
    "async def log_action(bot, guild, titre, description, couleur=None, champs=None):",
    "    \"\"\"Envoie une entrée dans le salon de logs du serveur, s'il est configuré.\"\"\"",
    "    if guild is None:",
    "        return",
    "    salon_id = core.get_log_channel(guild.id)",
    "    if not salon_id:",
    "        return",
    "    salon = guild.get_channel(salon_id)",
    "    if not salon or not salon.permissions_for(guild.me).send_messages:",
    "        return",
    "    embed = discord.Embed(",
    "        title=titre,",
    "        description=description,",
    "        color=couleur or discord.Color.orange(),",
    "        timestamp=discord.utils.utcnow(),",
    "    )",
    "    for nom, valeur, inline in (champs or []):",
    "        embed.add_field(name=nom, value=valeur, inline=inline)",
    "    try:",
    "        await salon.send(embed=embed)",
    "    except discord.HTTPException:",
    "        pass",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Analyse d'un message",
    "# ---------------------------------------------------------------------------",
    "",
    "def _analyser(message, config):",
    "    \"\"\"Renvoie (regle_violee, detail) ou (None, None) si le message est propre.\"\"\"",
    "    contenu = message.content or \"\"",
    "",
    "    if config.get(\"invitations\") and INVITE_RE.search(contenu):",
    "        return \"invitations\", \"invitation vers un autre serveur\"",
    "",
    "    if config.get(\"liens\") and LIEN_RE.search(contenu):",
    "        autorises = config.get(\"liens_autorises\", [])",
    "        liens = LIEN_RE.findall(contenu)",
    "        if any(not any(dom in lien.lower() for dom in autorises) for lien in liens):",
    "            return \"liens\", \"lien externe\"",
    "",
    "    if config.get(\"mots_interdits\"):",
    "        mots = [m.lower() for m in config.get(\"liste_mots\", []) if m]",
    "        if mots:",
    "            texte = contenu.lower()",
    "            for mot in mots:",
    "                if re.search(r\"\\b\" + re.escape(mot) + r\"\\b\", texte):",
    "                    return \"mots_interdits\", f\"mot filtré\"",
    "",
    "    if config.get(\"majuscules\"):",
    "        lettres = [c for c in contenu if c.isalpha()]",
    "        seuil = config.get(\"majuscules_seuil\", 0.7)",
    "        mini = config.get(\"majuscules_min_longueur\", 12)",
    "        if len(lettres) >= mini:",
    "            part = sum(1 for c in lettres if c.isupper()) / len(lettres)",
    "            if part >= seuil:",
    "                return \"majuscules\", f\"{part * 100:.0f}% de majuscules\"",
    "",
    "    if config.get(\"mentions\"):",
    "        maxi = config.get(\"mentions_max\", 5)",
    "        total = len(message.mentions) + len(message.role_mentions)",
    "        if total > maxi:",
    "            return \"mentions\", f\"{total} mentions (max {maxi})\"",
    "",
    "    if config.get(\"spam\"):",
    "        cle = (message.guild.id, message.author.id)",
    "        maintenant = time.monotonic()",
    "        _historique[cle].append(maintenant)",
    "        fenetre = config.get(\"spam_fenetre\", 5)",
    "        limite = config.get(\"spam_max\", 5)",
    "        recents = [t for t in _historique[cle] if maintenant - t <= fenetre]",
    "        if len(recents) > limite:",
    "            _historique[cle].clear()",
    "            return \"spam\", f\"{len(recents)} messages en {fenetre}s\"",
    "",
    "    return None, None",
    "",
    "",
    "async def handle_message(bot, message):",
    "    \"\"\"Applique l'automod. Renvoie True si le message a été supprimé.\"\"\"",
    "    if message.guild is None or message.author.bot:",
    "        return False",
    "    # Les admins et modérateurs ne sont jamais filtrés.",
    "    if core.is_admin(message.author):",
    "        return False",
    "    perms = message.author.guild_permissions",
    "    if perms.manage_messages or perms.manage_guild:",
    "        return False",
    "",
    "    config = core.get_automod_config(message.guild.id)",
    "    if not any(v is True for v in config.values()):",
    "        return False",
    "",
    "    salons_exemptes = config.get(\"salons_exemptes\", [])",
    "    if message.channel.id in salons_exemptes:",
    "        return False",
    "",
    "    regle, detail = _analyser(message, config)",
    "    if not regle:",
    "        return False",
    "",
    "    try:",
    "        await message.delete()",
    "    except (discord.Forbidden, discord.NotFound):",
    "        return False",
    "",
    "    # Avertissement éphémère dans le salon",
    "    try:",
    "        avis = await message.channel.send(",
    "            f\"🛡️ {message.author.mention}, ton message a été supprimé : \"",
    "            f\"**{REGLES.get(regle, regle)}**.\"",
    "        )",
    "        await avis.delete(delay=8)",
    "    except discord.HTTPException:",
    "        pass",
    "",
    "    # Comptage des infractions et sanctions progressives",
    "    total = core.add_automod_strike(message.guild.id, message.author.id, regle)",
    "    sanction = None",
    "    seuil_mute = config.get(\"seuil_mute\", 5)",
    "    duree_mute = config.get(\"duree_mute_minutes\", 10)",
    "    if total > 0 and total % seuil_mute == 0:",
    "        try:",
    "            await message.author.timeout(",
    "                timedelta(minutes=duree_mute), reason=f\"Automod : {REGLES.get(regle, regle)}\"",
    "            )",
    "            sanction = f\"timeout {duree_mute} min\"",
    "            core.add_mod_log(",
    "                message.guild.id, message.author.id, f\"timeout auto ({duree_mute} min)\",",
    "                f\"Automod : {REGLES.get(regle, regle)}\", bot.user.id,",
    "            )",
    "        except discord.Forbidden:",
    "            pass",
    "",
    "    await log_action(",
    "        bot, message.guild,",
    "        \"🛡️ Message supprimé par l'automod\",",
    "        f\"{message.author.mention} dans {message.channel.mention}\",",
    "        discord.Color.orange(),",
    "        [",
    "            (\"Règle\", REGLES.get(regle, regle), True),",
    "            (\"Détail\", detail or \"—\", True),",
    "            (\"Infractions\", f\"{total}\", True),",
    "            (\"Contenu\", f\"```{(message.content or '(vide)')[:300]}```\", False),",
    "        ] + ([(\"Sanction\", sanction, False)] if sanction else []),",
    "    )",
    "    return True",
    "",
    "",
    "# ---------------------------------------------------------------------------",
    "# Écouteurs d'événements pour le journal",
    "# ---------------------------------------------------------------------------",
    "",
    "def register_automod(bot):",
    "",
    "    @bot.listen(\"on_message_delete\")",
    "    async def _log_suppression(message):",
    "        if message.guild is None or message.author.bot:",
    "            return",
    "        await log_action(",
    "            bot, message.guild, \"🗑️ Message supprimé\",",
    "            f\"De {message.author.mention} dans {message.channel.mention}\",",
    "            discord.Color.red(),",
    "            [(\"Contenu\", f\"```{(message.content or '(pas de texte)')[:900]}```\", False)],",
    "        )",
    "",
    "    @bot.listen(\"on_message_edit\")",
    "    async def _log_edition(avant, apres):",
    "        if avant.guild is None or avant.author.bot or avant.content == apres.content:",
    "            return",
    "        await log_action(",
    "            bot, avant.guild, \"✏️ Message modifié\",",
    "            f\"De {avant.author.mention} dans {avant.channel.mention} — [aller au message]({apres.jump_url})\",",
    "            discord.Color.blue(),",
    "            [",
    "                (\"Avant\", f\"```{(avant.content or '(vide)')[:450]}```\", False),",
    "                (\"Après\", f\"```{(apres.content or '(vide)')[:450]}```\", False),",
    "            ],",
    "        )",
    "",
    "    @bot.listen(\"on_member_join\")",
    "    async def _log_arrivee(member):",
    "        anciennete = discord.utils.utcnow() - member.created_at",
    "        alerte = \" ⚠️ **compte très récent**\" if anciennete.days < 7 else \"\"",
    "        await log_action(",
    "            bot, member.guild, \"📥 Arrivée\",",
    "            f\"{member.mention} ({member})\",",
    "            discord.Color.green(),",
    "            [(\"Compte créé\", f\"{core.discord_timestamp(member.created_at)}{alerte}\", False)],",
    "        )",
    "",
    "    @bot.listen(\"on_member_remove\")",
    "    async def _log_depart(member):",
    "        roles = [r.mention for r in member.roles if r.name != \"@everyone\"]",
    "        await log_action(",
    "            bot, member.guild, \"📤 Départ\",",
    "            f\"{member.mention} ({member})\",",
    "            discord.Color.dark_grey(),",
    "            [(\"Rôles\", \", \".join(roles) if roles else \"aucun\", False)],",
    "        )",
    "",
    "    @bot.listen(\"on_member_update\")",
    "    async def _log_pseudo(avant, apres):",
    "        if avant.nick == apres.nick:",
    "            return",
    "        await log_action(",
    "            bot, apres.guild, \"📝 Pseudo modifié\",",
    "            f\"{apres.mention}\",",
    "            discord.Color.blurple(),",
    "            [(\"Avant\", avant.nick or \"*aucun*\", True), (\"Après\", apres.nick or \"*aucun*\", True)],",
    "        )",
    "",
    "    @bot.listen(\"on_raw_reaction_add\")",
    "    async def _starboard(payload):",
    "        import community",
    "        await community.handle_reaction(bot, payload)",
    "",
    "    # ---------------------------------------------------------- commandes",
    "    automod_group = app_commands.Group(",
    "        name=\"automod\",",
    "        description=\"🛡️ Modération automatique\",",
    "        default_permissions=discord.Permissions(administrator=True),",
    "    )",
    "    bot.tree.add_command(automod_group)",
    "",
    "    @automod_group.command(name=\"regle\", description=\"Activer ou désactiver une règle\")",
    "    @core.check_admin()",
    "    @app_commands.describe(regle=\"La protection à régler\", actif=\"Activer ou désactiver\")",
    "    @app_commands.choices(regle=[",
    "        app_commands.Choice(name=\"Anti-spam (messages trop rapides)\", value=\"spam\"),",
    "        app_commands.Choice(name=\"Anti-liens\", value=\"liens\"),",
    "        app_commands.Choice(name=\"Anti-invitations Discord\", value=\"invitations\"),",
    "        app_commands.Choice(name=\"Anti-MAJUSCULES\", value=\"majuscules\"),",
    "        app_commands.Choice(name=\"Filtre de mots interdits\", value=\"mots_interdits\"),",
    "        app_commands.Choice(name=\"Anti-mentions massives\", value=\"mentions\"),",
    "    ])",
    "    async def automod_regle(interaction: discord.Interaction,",
    "                            regle: app_commands.Choice[str], actif: bool):",
    "        core.set_automod_option(interaction.guild_id, regle.value, actif)",
    "        await interaction.response.send_message(",
    "            f\"{'✅ Activé' if actif else '🚫 Désactivé'} : **{regle.name}**\", ephemeral=True",
    "        )",
    "",
    "    @automod_group.command(name=\"mots\", description=\"Gérer la liste des mots interdits\")",
    "    @core.check_admin()",
    "    @app_commands.describe(action=\"Ajouter, retirer ou lister\", mot=\"Le mot concerné\")",
    "    @app_commands.choices(action=[",
    "        app_commands.Choice(name=\"ajouter\", value=\"ajouter\"),",
    "        app_commands.Choice(name=\"retirer\", value=\"retirer\"),",
    "        app_commands.Choice(name=\"lister\", value=\"lister\"),",
    "    ])",
    "    async def automod_mots(interaction: discord.Interaction,",
    "                           action: app_commands.Choice[str], mot: str = None):",
    "        config = core.get_automod_config(interaction.guild_id)",
    "        mots = list(config.get(\"liste_mots\", []))",
    "",
    "        if action.value == \"lister\":",
    "            await interaction.response.send_message(",
    "                (\"🚫 Mots interdits : \" + \", \".join(f\"||{m}||\" for m in mots))",
    "                if mots else \"Aucun mot interdit configuré.\",",
    "                ephemeral=True,",
    "            )",
    "            return",
    "        if not mot:",
    "            await interaction.response.send_message(",
    "                \"❌ Précise le mot à ajouter ou retirer.\", ephemeral=True",
    "            )",
    "            return",
    "",
    "        mot = mot.strip().lower()",
    "        if action.value == \"ajouter\":",
    "            if mot in mots:",
    "                await interaction.response.send_message(\"❌ Ce mot est déjà filtré.\", ephemeral=True)",
    "                return",
    "            mots.append(mot)",
    "            message = f\"✅ Le mot ||{mot}|| est maintenant filtré.\"",
    "        else:",
    "            if mot not in mots:",
    "                await interaction.response.send_message(\"❌ Ce mot n'est pas dans la liste.\", ephemeral=True)",
    "                return",
    "            mots.remove(mot)",
    "            message = f\"✅ Le mot ||{mot}|| n'est plus filtré.\"",
    "",
    "        core.set_automod_option(interaction.guild_id, \"liste_mots\", mots)",
    "        await interaction.response.send_message(message, ephemeral=True)",
    "",
    "    @automod_group.command(name=\"exempter\", description=\"Exempter (ou réintégrer) un salon de l'automod\")",
    "    @core.check_admin()",
    "    async def automod_exempter(interaction: discord.Interaction, salon: discord.TextChannel):",
    "        config = core.get_automod_config(interaction.guild_id)",
    "        exemptes = list(config.get(\"salons_exemptes\", []))",
    "        if salon.id in exemptes:",
    "            exemptes.remove(salon.id)",
    "            message = f\"✅ {salon.mention} est de nouveau surveillé.\"",
    "        else:",
    "            exemptes.append(salon.id)",
    "            message = f\"✅ {salon.mention} est exempté de l'automod.\"",
    "        core.set_automod_option(interaction.guild_id, \"salons_exemptes\", exemptes)",
    "        await interaction.response.send_message(message, ephemeral=True)",
    "",
    "    @automod_group.command(name=\"etat\", description=\"Voir l'état de toutes les protections\")",
    "    @core.check_admin()",
    "    async def automod_etat(interaction: discord.Interaction):",
    "        config = core.get_automod_config(interaction.guild_id)",
    "        lignes = []",
    "        for cle, libelle in REGLES.items():",
    "            lignes.append(f\"{'✅' if config.get(cle) else '⬜'} **{libelle}**\")",
    "        embed = discord.Embed(",
    "            title=\"🛡️ État de l'automod\",",
    "            description=\"\\n\".join(lignes),",
    "            color=discord.Color.blurple(),",
    "        )",
    "        embed.add_field(",
    "            name=\"Réglages\",",
    "            value=(",
    "                f\"Spam : {config.get('spam_max', 5)} msg / {config.get('spam_fenetre', 5)}s\\n\"",
    "                f\"Majuscules : à partir de {int(config.get('majuscules_seuil', 0.7) * 100)}%\\n\"",
    "                f\"Mentions max : {config.get('mentions_max', 5)}\\n\"",
    "                f\"Timeout auto : {config.get('duree_mute_minutes', 10)} min \"",
    "                f\"toutes les {config.get('seuil_mute', 5)} infractions\"",
    "            ),",
    "            inline=False,",
    "        )",
    "        mots = config.get(\"liste_mots\", [])",
    "        embed.add_field(name=\"Mots filtrés\", value=f\"{len(mots)} mot(s)\", inline=True)",
    "        exemptes = config.get(\"salons_exemptes\", [])",
    "        embed.add_field(name=\"Salons exemptés\", value=f\"{len(exemptes)}\", inline=True)",
    "        salon_logs = core.get_log_channel(interaction.guild_id)",
    "        embed.set_footer(",
    "            text=\"Logs : \" + (\"configurés\" if salon_logs else \"non configurés — /configurer logs\")",
    "        )",
    "        await interaction.response.send_message(embed=embed, ephemeral=True)",
    ""
  ]
}
