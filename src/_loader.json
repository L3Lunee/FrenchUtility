{
  "module": "_loader",
  "language": "python",
  "description": "Chargeur d'amorcage : importe les modules depuis src/*.json puis demarre bot.json.",
  "entrypoint": false,
  "source": [
    "# Chargeur : rend les fichiers src/*.json importables comme des modules Python.",
    "# Quand le code fait `import core`, Python lit src/core.json au lieu de core.py.",
    "import importlib.abc",
    "import importlib.util",
    "import json",
    "import os",
    "import sys",
    "",
    "MODULES_DIR = \"src\"",
    "",
    "",
    "def read_source(path):",
    "    with open(path, \"r\", encoding=\"utf-8\") as f:",
    "        data = json.load(f)",
    "    source = data.get(\"source\", \"\")",
    "    if isinstance(source, list):",
    "        source = chr(10).join(source)",
    "    return source",
    "",
    "",
    "class JsonModuleLoader(importlib.abc.Loader):",
    "    def __init__(self, path):",
    "        self.path = path",
    "",
    "    def create_module(self, spec):",
    "        return None",
    "",
    "    def exec_module(self, module):",
    "        module.__file__ = self.path",
    "        exec(compile(read_source(self.path), self.path, \"exec\"), module.__dict__)",
    "",
    "",
    "class JsonModuleFinder(importlib.abc.MetaPathFinder):",
    "    def find_spec(self, fullname, path=None, target=None):",
    "        candidate = os.path.join(MODULES_DIR, fullname + \".json\")",
    "        if os.path.isfile(candidate):",
    "            return importlib.util.spec_from_loader(",
    "                fullname, JsonModuleLoader(candidate), origin=candidate",
    "            )",
    "        return None",
    "",
    "",
    "sys.meta_path.insert(0, JsonModuleFinder())",
    "",
    "entry = os.path.join(MODULES_DIR, \"bot.json\")",
    "main_module = type(sys)(\"__main__\")",
    "main_module.__file__ = entry",
    "sys.modules[\"__main__\"] = main_module",
    "exec(compile(read_source(entry), entry, \"exec\"), main_module.__dict__)"
  ]
}
