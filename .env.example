# Copie ce fichier en .env et remplis TOKEN avec ton vrai token Discord.
# Discord Developer Portal > ton application > Bot > Reset Token
TOKEN=colle_ton_token_ici

# Préfixe des commandes textuelles rapides (-clear, -ban, -hide…)
PREFIX=/

# Propriétaires du bot (facultatif) : IDs Discord séparés par des virgules.
# Ils ont les droits d'administrateur DU BOT sur tous les serveurs où ils sont,
# même sans être admin du serveur. Ne mets ici que des comptes de confiance.
PROPRIETAIRES=
